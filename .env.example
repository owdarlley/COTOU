# Aplicação
NODE_ENV=development
PORT=3000
SESSION_SECRET=mude-para-uma-string-longa-e-aleatoria-em-producao

# Banco de Dados
DB_PATH=./data/cotou.db

# API de Consulta de Placa Brasileira (wdapi2.com.br ou apiplacas.com.br)
PLATE_API_BASE_URL=https://wdapi2.com.br
PLATE_API_TOKEN=seu_token_aqui

# Evolution API (WhatsApp)
# Para desenvolvimento local, suba com: docker compose -f docker-compose.evolution.yml up -d
# (os valores abaixo já batem com o que esse compose configura por padrão)
WHATSAPP_API_URL=http://localhost:8081
WHATSAPP_API_KEY=cotou-local-dev-key
WHATSAPP_INSTANCE_NAME=cotou-instance

# Usuário admin inicial (usado apenas na primeira execução)
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=admin123
