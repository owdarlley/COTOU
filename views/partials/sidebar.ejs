<% if (currentUser) {
  const p = locals.currentPath || '';
  const initials = currentUser.name.split(' ').slice(0,2).map(w => w[0]).join('').toUpperCase();
  const roleLabel = { admin: 'Administrador', vendas: 'Setor de Vendas', compras: 'Setor de Compras' }[currentUser.role] || currentUser.role;
%>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <h1 class="sidebar-logo">COTOU</h1>
    <p class="sidebar-tagline">Enterprise Resource Planning</p>
  </div>
  <nav>
    <ul>
      <li class="nav-item">
        <a href="/" class="nav-link <%= p === '/' ? 'active' : '' %>">
          <span class="material-symbols-outlined">dashboard</span>Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a href="/cotacoes" class="nav-link <%= p.startsWith('/cotacoes') && !p.startsWith('/cotacoes/nova') ? 'active' : '' %>">
          <span class="material-symbols-outlined">request_quote</span>Cotações
          <% if (unreadCount > 0) { %><span class="nav-badge orange"><%= unreadCount %></span><% } %>
        </a>
      </li>
      <% if (currentUser.role === 'vendas' || currentUser.role === 'admin') { %>
      <li class="nav-item">
        <a href="/cotacoes/nova" class="nav-link <%= p === '/cotacoes/nova' ? 'active' : '' %>">
          <span class="material-symbols-outlined">add_box</span>Nova Cotação
        </a>
      </li>
      <% } %>
      <li class="nav-item">
        <a href="/pecas" class="nav-link <%= p.startsWith('/pecas') ? 'active' : '' %>">
          <span class="material-symbols-outlined">inventory_2</span>Catálogo
        </a>
      </li>
      <li class="nav-item">
        <a href="/notificacoes" id="nav-notif-link"
           class="nav-link <%= p.startsWith('/notificacoes') ? 'active' : (locals.hasRespondida ? 'nav-link-alert' : '') %>">
          <span class="material-symbols-outlined<%= locals.hasRespondida && !p.startsWith('/notificacoes') ? ' bell-ringing' : '' %>">notifications</span>Notificações
          <% if (unreadCount > 0) { %><span class="nav-badge"><%= unreadCount %></span><% } %>
        </a>
      </li>
      <% if (currentUser.role === 'admin') { %>
      <li class="nav-item">
        <a href="/admin/usuarios" class="nav-link <%= p.startsWith('/admin') ? 'active' : '' %>">
          <span class="material-symbols-outlined">group</span>Usuários
        </a>
      </li>
      <% } %>
      <li class="nav-item nav-item-bottom">
        <a href="#" class="nav-link">
          <span class="material-symbols-outlined">settings</span>Configurações
        </a>
      </li>
    </ul>
  </nav>
  <div class="sidebar-footer">
    <div class="av" style="width:32px;height:32px;font-size:11px;background:var(--accent);flex-shrink:0"><%= initials %></div>
    <div style="flex:1;min-width:0">
      <div class="sidebar-footer-name"><%= currentUser.name %></div>
      <div class="sidebar-footer-role"><%= roleLabel %></div>
    </div>
    <form action="/logout" method="POST">
      <button type="submit" class="sidebar-footer-logout" title="Sair">
        <i class="bi bi-box-arrow-right"></i>
      </button>
    </form>
  </div>
</aside>
<% } %>
