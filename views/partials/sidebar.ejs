<% if (currentUser) {
  const p = locals.currentPath || '';
  const initials = currentUser.name.split(' ').slice(0,2).map(w => w[0]).join('').toUpperCase();
  const avatarClass = currentUser.role === 'compras' ? 'green' : currentUser.role === 'admin' ? 'orange' : '';
  const roleLabel = currentUser.role === 'vendas' ? 'Setor de Vendas' : currentUser.role === 'compras' ? 'Setor de Compras' : 'Administrador';
%>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <h1>COTOU</h1>
    <span>Sistema de Cotações</span>
  </div>
  <nav>
    <ul>
      <li class="nav-item">
        <a href="/" class="nav-link <%= p === '/' ? 'active' : '' %>">
          <i class="bi bi-grid-1x2"></i>Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a href="/cotacoes" class="nav-link <%= p.startsWith('/cotacoes') && !p.startsWith('/cotacoes/nova') ? 'active' : '' %>">
          <i class="bi bi-clipboard-list"></i>Cotações
          <% if (unreadCount > 0) { %><span class="nav-badge orange"><%= unreadCount %></span><% } %>
        </a>
      </li>
      <% if (currentUser.role === 'vendas' || currentUser.role === 'admin') { %>
      <li class="nav-item">
        <a href="/cotacoes/nova" class="nav-link <%= p === '/cotacoes/nova' ? 'active' : '' %>">
          <i class="bi bi-plus-circle"></i>Nova Cotação
        </a>
      </li>
      <% } %>
      <li class="nav-item" style="margin-top:8px">
        <a href="/pecas" class="nav-link <%= p.startsWith('/pecas') ? 'active' : '' %>">
          <i class="bi bi-box-seam"></i>Catálogo de Peças
        </a>
      </li>
      <li class="nav-item">
        <a href="/notificacoes" class="nav-link <%= p.startsWith('/notificacoes') ? 'active' : '' %>">
          <i class="bi bi-bell"></i>Notificações
          <% if (unreadCount > 0) { %><span class="nav-badge"><%= unreadCount %></span><% } %>
        </a>
      </li>
      <% if (currentUser.role === 'admin') { %>
      <li class="nav-item" style="margin-top:8px">
        <a href="/admin/usuarios" class="nav-link <%= p.startsWith('/admin') ? 'active' : '' %>">
          <i class="bi bi-people"></i>Usuários
        </a>
      </li>
      <% } %>
    </ul>
  </nav>
  <div class="sidebar-footer">
    <div class="user-av <%= avatarClass %>"><%= initials %></div>
    <div class="user-info">
      <div class="user-name"><%= currentUser.name %></div>
      <div class="user-role"><%= roleLabel %></div>
    </div>
    <form action="/logout" method="POST" style="margin:0">
      <button type="submit" class="logout" title="Sair"><i class="bi bi-box-arrow-right"></i></button>
    </form>
  </div>
</aside>
<% } %>
