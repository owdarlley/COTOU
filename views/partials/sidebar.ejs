<% if (currentUser) {
  const p = locals.currentPath || '';
  const initials = currentUser.name.split(' ').slice(0,2).map(w => w[0]).join('').toUpperCase();
  const roleLabel = { admin: 'Administrador', vendas: 'Setor de Vendas', compras: 'Setor de Compras' }[currentUser.role] || currentUser.role;
  const roleTone  = { admin: 'violet', vendas: '', compras: 'green' }[currentUser.role] || '';
%>
<aside class="sidebar">
  <div class="sb-brand">
    <div class="sb-logo">
      <svg width="18" height="18" viewBox="0 0 28 28" fill="none">
        <path d="M7 14h6M15 10l4 4-4 4" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="sb-name">COTOU</div>
  </div>

  <nav class="sb-nav">
    <a href="/" class="sb-link <%= p === '/' ? 'active' : '' %>">
      <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
    </a>
    <a href="/cotacoes" class="sb-link <%= p.startsWith('/cotacoes') && p !== '/cotacoes/nova' ? 'active' : '' %>">
      <i class="bi bi-file-earmark-text"></i><span>Cotações</span>
      <% if (locals.pendingCount && pendingCount > 0) { %><span class="nav-count amber"><%= pendingCount %></span><% } %>
    </a>
    <% if (currentUser.role === 'vendas' || currentUser.role === 'admin') { %>
    <a href="/cotacoes/nova" class="sb-link <%= p === '/cotacoes/nova' ? 'active' : '' %>">
      <i class="bi bi-plus-square"></i><span>Nova Cotação</span>
    </a>
    <% } %>
    <a href="/pecas" class="sb-link <%= p.startsWith('/pecas') ? 'active' : '' %>">
      <i class="bi bi-grid"></i><span>Catálogo</span>
    </a>
    <a href="/notificacoes" class="sb-link <%= p.startsWith('/notificacoes') ? 'active' : '' %>">
      <i class="bi bi-bell"></i><span>Notificações</span>
      <% if (unreadCount > 0) { %><span class="nav-count"><%= unreadCount %></span><% } %>
    </a>
  </nav>

  <% if (currentUser.role === 'admin') { %>
  <div class="sb-section">Administração</div>
  <nav class="sb-nav">
    <a href="/admin/usuarios" class="sb-link <%= p.startsWith('/admin') ? 'active' : '' %>">
      <i class="bi bi-shield-lock"></i><span>Usuários</span>
    </a>
  </nav>
  <% } %>

  <div class="sb-footer">
    <div class="sb-user-divider"></div>
    <div class="sb-user">
      <div class="avatar md <%= roleTone %>"><%= initials %></div>
      <div class="sb-user-info">
        <div class="sb-user-name"><%= currentUser.name %></div>
        <div class="sb-user-role"><%= roleLabel %></div>
      </div>
      <form action="/logout" method="POST" style="margin:0">
        <button type="submit" class="icon-btn" title="Sair">
          <i class="bi bi-box-arrow-right"></i>
        </button>
      </form>
    </div>
  </div>
</aside>
<% } %>
