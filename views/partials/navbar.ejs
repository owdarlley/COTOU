<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/">
      <i class="bi bi-car-front-fill me-2"></i>COTOU
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMain">
      <% if (currentUser) { %>
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link" href="/cotacoes">
            <i class="bi bi-clipboard-list me-1"></i>Cotações
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/pecas">
            <i class="bi bi-box-seam me-1"></i>Catálogo de Peças
          </a>
        </li>
        <% if (currentUser.role === 'vendas' || currentUser.role === 'admin') { %>
        <li class="nav-item">
          <a class="nav-link btn btn-warning btn-sm text-dark fw-semibold ms-2 px-3" href="/cotacoes/nova">
            <i class="bi bi-plus-circle me-1"></i>Nova Cotação
          </a>
        </li>
        <% } %>
        <% if (currentUser.role === 'admin') { %>
        <li class="nav-item">
          <a class="nav-link" href="/admin/usuarios">
            <i class="bi bi-people me-1"></i>Usuários
          </a>
        </li>
        <% } %>
      </ul>
      <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item dropdown me-2">
          <a class="nav-link position-relative" href="#" data-bs-toggle="dropdown" id="notif-toggle">
            <i class="bi bi-bell-fill fs-5"></i>
            <% if (unreadCount > 0) { %>
            <span class="badge bg-danger rounded-pill position-absolute top-0 start-75" id="notif-badge">
              <%= unreadCount %>
            </span>
            <% } else { %>
            <span class="badge bg-danger rounded-pill position-absolute top-0 start-75 d-none" id="notif-badge">0</span>
            <% } %>
          </a>
          <div class="dropdown-menu dropdown-menu-end notif-dropdown p-0" style="min-width:340px">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
              <span class="fw-semibold">Notificações</span>
              <a href="/notificacoes" class="small text-primary">Ver todas</a>
            </div>
            <div id="notif-list">
              <% if (recentNotifications.length === 0) { %>
              <div class="text-center text-muted py-3 small">Nenhuma notificação</div>
              <% } else { %>
              <% recentNotifications.forEach(n => { %>
              <a href="/cotacoes/<%= n.quotation_id %>" class="dropdown-item py-2 border-bottom <%= n.read_at ? '' : 'notif-unread' %>">
                <div class="fw-semibold small"><%= n.title %></div>
                <div class="text-muted small"><%= n.message.substring(0, 70) %><%= n.message.length > 70 ? '…' : '' %></div>
              </a>
              <% }) %>
              <% } %>
            </div>
            <div class="text-center p-2">
              <form action="/notificacoes/todas-lidas" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Marcar todas como lidas</button>
              </form>
            </div>
          </div>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle me-1"></i><%= currentUser.name %>
            <span class="badge ms-1 <%= currentUser.role === 'vendas' ? 'bg-info' : currentUser.role === 'compras' ? 'bg-success' : 'bg-warning text-dark' %>">
              <%= currentUser.role %>
            </span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/notificacoes"><i class="bi bi-bell me-2"></i>Notificações</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="POST" class="px-3">
                <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                  <i class="bi bi-box-arrow-right me-1"></i>Sair
                </button>
              </form>
            </li>
          </ul>
        </li>
      </ul>
      <% } %>
    </div>
  </div>
</nav>
