<% if (flash.success) { %>
<div class="alert-success-custom">
  <i class="bi bi-check-circle-fill"></i><span><%= flash.success %></span>
</div>
<% } %>
<% if (flash.error) { %>
<div class="alert-danger-custom">
  <i class="bi bi-exclamation-triangle-fill"></i><span><%= flash.error %></span>
</div>
<% } %>
