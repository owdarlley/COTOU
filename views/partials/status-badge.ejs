<% const cfg = {
  pendente:    { label: 'Aguardando',   cls: 'badge-pending'  },
  em_cotacao:  { label: 'Em Cotação',  cls: 'badge-quotando' },
  cotado:      { label: 'Cotado',       cls: 'badge-cotado'   },
  peca_chegou: { label: 'Peça Chegou', cls: 'badge-chegou'   },
  cancelado:   { label: 'Cancelado',    cls: 'badge-cancel'   }
}[status] || { label: status, cls: 'badge-pending' }; %>
<span class="badge <%= cfg.cls %>"><%= cfg.label %></span>
