<% const cfg = {
  pendente:    { label: 'Aguardando',  cls: 'pendente'   },
  em_cotacao:  { label: 'Em Cotação',  cls: 'em_cotacao' },
  cotado:      { label: 'Cotado',      cls: 'cotado'     },
  peca_chegou: { label: 'Peça Chegou', cls: 'peca_chegou'},
  cancelado:   { label: 'Cancelado',   cls: 'cancelado'  }
}[status] || { label: status, cls: 'pendente' }; %>
<span class="status <%= cfg.cls %>">
  <span class="dot"></span><%= cfg.label %>
</span>
