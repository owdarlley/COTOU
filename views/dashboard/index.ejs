<div class="stats-grid">
  <a href="/cotacoes?status=pendente" class="stat-card">
    <div class="stat-icon si-orange"><i class="bi bi-clock"></i></div>
    <div>
      <div class="stat-num"><%= statusMap.pendente || 0 %></div>
      <div class="stat-label">Aguardando</div>
    </div>
  </a>
  <a href="/cotacoes?status=em_cotacao" class="stat-card">
    <div class="stat-icon si-blue"><i class="bi bi-search"></i></div>
    <div>
      <div class="stat-num"><%= statusMap.em_cotacao || 0 %></div>
      <div class="stat-label">Em Cotação</div>
    </div>
  </a>
  <a href="/cotacoes?status=cotado" class="stat-card">
    <div class="stat-icon si-green"><i class="bi bi-check-circle"></i></div>
    <div>
      <div class="stat-num"><%= statusMap.cotado || 0 %></div>
      <div class="stat-label">Cotado</div>
    </div>
  </a>
  <a href="/cotacoes?status=peca_chegou" class="stat-card">
    <div class="stat-icon si-purple"><i class="bi bi-box-arrow-in-down"></i></div>
    <div>
      <div class="stat-num"><%= statusMap.peca_chegou || 0 %></div>
      <div class="stat-label">Peça Chegou</div>
    </div>
  </a>
</div>

<div class="table-wrap">
  <div class="form-section-header">
    <span><i class="bi bi-clock-history"></i> Cotações Recentes</span>
    <a href="/cotacoes" class="btn-outline" style="padding:5px 12px;font-size:12px">Ver todas</a>
  </div>
  <% if (recentQuotations.length === 0) { %>
  <div style="text-align:center;padding:48px 16px;color:var(--gray)">
    <i class="bi bi-inbox" style="font-size:40px;display:block;margin-bottom:8px"></i>
    Nenhuma cotação ainda.
    <% if (currentUser.role === 'vendas' || currentUser.role === 'admin') { %>
    <br><a href="/cotacoes/nova" class="btn-primary" style="margin-top:16px;display:inline-flex">
      <i class="bi bi-plus-circle"></i>Criar primeira cotação
    </a>
    <% } %>
  </div>
  <% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Nº</th><th>Cliente</th><th>Veículo</th><th>Status</th><th>Data</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% recentQuotations.forEach(q => { %>
      <tr>
        <td><a href="/cotacoes/<%= q.id %>" class="qid">#<%= q.quote_number %></a></td>
        <td><span style="font-weight:600"><%= q.customer_name %></span></td>
        <td>
          <span style="font-size:13px"><%= q.make || '' %> <%= q.model || '' %></span>
          <% if (q.license_plate) { %><br><span class="plate-tag"><%= q.license_plate %></span><% } %>
        </td>
        <td><%- include('../partials/status-badge', { status: q.status }) %></td>
        <td style="color:var(--gray);font-size:13px"><%= new Date(q.created_at).toLocaleDateString('pt-BR') %></td>
        <td><a href="/cotacoes/<%= q.id %>" class="actions-btn" title="Ver">⋯</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
