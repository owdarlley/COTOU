<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= locals.theme || 'light' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | COTOU</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body class="density-cozy">

<div class="app">
  <%- include('partials/sidebar') %>

  <div class="main">
    <div class="topbar">
      <nav class="tb-crumbs">
        <a href="/">Dashboard</a>
        <% if (locals.breadcrumb && breadcrumb.length) { %>
          <% breadcrumb.forEach((c, i) => { %>
            <i class="bi bi-chevron-right"></i>
            <% if (i < breadcrumb.length - 1) { %>
              <a href="<%= c.href %>"><%= c.label %></a>
            <% } else { %>
              <span class="here"><%= c.label %></span>
            <% } %>
          <% }) %>
        <% } else { %>
          <% if (title && title.toLowerCase() !== 'dashboard') { %>
            <i class="bi bi-chevron-right"></i>
            <span class="here"><%= title.replace(' — COTOU','').replace(' | COTOU','') %></span>
          <% } %>
        <% } %>
      </nav>

      <% if (currentUser) { %>
      <form method="GET" action="/cotacoes" class="tb-search">
        <i class="bi bi-search"></i>
        <input type="text" name="q" placeholder="Buscar cotações, peças, clientes…"
               value="<%= typeof q !== 'undefined' ? q : '' %>">
        <span class="kbd">⌘K</span>
      </form>

      <div class="tb-actions">
        <a href="/notificacoes" class="icon-btn" title="Notificações">
          <i class="bi bi-bell"></i>
          <% if (unreadCount > 0) { %><span class="dot"></span><% } %>
        </a>
      </div>
      <% } %>
    </div>

    <%- include('partials/flash') %>
    <%- body %>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  window.__USER_ID__ = '<%= currentUser ? currentUser.id : "" %>';
  window.__USER_ROLE__ = '<%= currentUser ? currentUser.role : "" %>';
  window.__HAS_RESPONDIDA__ = <%= currentUser && locals.hasRespondida ? 'true' : 'false' %>;

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
    if (e.key === '/') { e.preventDefault(); const i = document.querySelector('.tb-search input'); i && i.focus(); }
    if (e.key === 'n') { window.location.href = '/cotacoes/nova'; }
  });
</script>
<script src="/js/socket-client.js"></script>
<%- typeof scripts !== 'undefined' ? scripts : '' %>
</body>
</html>
