<div class="toolbar">
  <div class="toolbar-left">
    <span style="font-size:16px;font-weight:700">Notificações</span>
  </div>
  <div class="toolbar-right">
    <form action="/notificacoes/todas-lidas" method="POST">
      <button type="submit" class="btn-cancel" style="padding:7px 14px;font-size:13px">
        <i class="bi bi-check-all"></i>Marcar todas como lidas
      </button>
    </form>
  </div>
</div>

<div class="table-wrap">
  <% if (items.length === 0) { %>
  <div style="text-align:center;padding:48px 16px;color:var(--gray)">
    <i class="bi bi-bell-slash" style="font-size:40px;display:block;margin-bottom:8px"></i>Nenhuma notificação.
  </div>
  <% } else { %>
  <% items.forEach(n => { %>
  <a href="<%= n.quotation_id ? '/cotacoes/' + n.quotation_id : '#' %>"
    class="notif-item <%= n.read_at ? '' : 'notif-unread' %>">
    <% const dotClass = { nova_cotacao:'orange', cotacao_respondida:'green', peca_chegou:'purple', status_atualizado:'blue', cotacao_atualizada:'gray' }[n.type] || 'gray'; %>
    <div class="ndot <%= dotClass %>"></div>
    <div style="flex:1;min-width:0">
      <div style="font-weight:600;font-size:14px;color:<%= n.read_at ? 'var(--gray)' : 'var(--text)' %>"><%= n.title %></div>
      <div style="font-size:13px;color:var(--gray);margin-top:2px"><%= n.message %></div>
      <div style="font-size:12px;color:var(--gray);margin-top:4px">
        <%= new Date(n.created_at).toLocaleString('pt-BR') %>
        <% if (n.quote_number) { %> · Cotação #<%= n.quote_number %><% } %>
      </div>
    </div>
    <% if (!n.read_at) { %><span class="badge badge-quotando">Nova</span><% } %>
  </a>
  <% }) %>
  <% if (pages > 1) { %>
  <div class="pagination-wrap">
    <ul class="pagination">
      <% for (let p = 1; p <= pages; p++) { %>
      <li class="page-item <%= p === page ? 'active' : '' %>">
        <a class="page-link" href="?page=<%= p %>"><%= p %></a>
      </li>
      <% } %>
    </ul>
  </div>
  <% } %>
  <% } %>
</div>
