<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:10px">
  <div>
    <h4 style="font-size:18px;font-weight:700;margin:0">Notificações</h4>
    <% if (unreadCount > 0) { %>
    <p style="font-size:13px;color:var(--text-muted);margin:2px 0 0"><%= unreadCount %> não lida<%= unreadCount > 1 ? 's' : '' %></p>
    <% } %>
  </div>
  <form action="/notificacoes/todas-lidas" method="POST">
    <button type="submit" class="btn-cancel" style="padding:7px 14px;font-size:13px">
      <i class="bi bi-check-all"></i>Marcar todas como lidas
    </button>
  </form>
</div>

<% if (items.length === 0) { %>
<div style="background:var(--card);border:1px solid var(--border);border-radius:12px;text-align:center;padding:56px 16px;color:var(--text-muted)">
  <i class="bi bi-bell-slash" style="font-size:40px;display:block;margin-bottom:8px"></i>
  Nenhuma notificação.
</div>
<% } else { %>

<% const iconMap = {
  nova_cotacao:       { icon: 'bi-plus-circle-fill',      cls: 'icon-blue'   },
  cotacao_respondida: { icon: 'bi-check-circle-fill',     cls: 'icon-green'  },
  peca_chegou:        { icon: 'bi-box-arrow-in-down',     cls: 'icon-purple' },
  status_atualizado:  { icon: 'bi-arrow-clockwise',       cls: 'icon-amber'  },
  cotacao_atualizada: { icon: 'bi-person-check-fill',     cls: 'icon-blue'   }
}; %>

<% items.forEach(n => {
  const ic = iconMap[n.type] || { icon: 'bi-bell', cls: 'icon-blue' };
%>
<a href="<%= n.quotation_id ? '/cotacoes/' + n.quotation_id : '#' %>"
   class="notif-card <%= n.read_at ? '' : 'unread' %>">
  <div class="kpi-icon <%= ic.cls %>" style="width:40px;height:40px;border-radius:10px;font-size:17px;flex-shrink:0">
    <i class="bi <%= ic.icon %>"></i>
  </div>
  <div style="flex:1;min-width:0">
    <div style="font-weight:700;font-size:13.5px;color:<%= n.read_at ? 'var(--text-muted)' : 'var(--text)' %>"><%= n.title %></div>
    <div style="font-size:12.5px;color:var(--text-muted);margin-top:3px;line-height:1.4"><%= n.message %></div>
    <div style="font-size:11px;color:var(--text-muted);margin-top:5px">
      <%= new Date(n.created_at).toLocaleString('pt-BR') %>
      <% if (n.quote_number) { %> · Cotação #<%= n.quote_number %><% } %>
    </div>
  </div>
  <% if (!n.read_at) { %>
  <span class="badge badge-blue" style="flex-shrink:0">Nova</span>
  <% } %>
</a>
<% }) %>

<% if (pages > 1) { %>
<div style="display:flex;justify-content:center;gap:4px;padding-top:8px">
  <% for (let pg = 1; pg <= pages; pg++) { %>
  <a href="?page=<%= pg %>" class="pag-btn <%= pg === page ? 'active' : '' %>"><%= pg %></a>
  <% } %>
</div>
<% } %>

<% } %>
