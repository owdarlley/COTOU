<%
  const canEdit = (currentUser.role === 'compras' || currentUser.role === 'admin') &&
                  (quotation.status === 'em_cotacao' || quotation.status === 'cotado') &&
                  quotation.status !== 'cancelado';
  const canAct  = (currentUser.role === 'compras' || currentUser.role === 'admin') &&
                  quotation.status !== 'cancelado';
  const isVendas = currentUser.role === 'vendas' || currentUser.role === 'admin';
  const showClientActions = isVendas &&
    (quotation.status === 'cotado' || quotation.status === 'peca_chegou');
  const defaultTab = canEdit ? 'valores' : 'pecas';

  // Formatadores
  const fmtBRL = v => {
    if (v == null) return '—';
    return 'R$ ' + parseFloat(v).toFixed(2)
      .replace('.', ',').replace(/(\d)(?=(\d{3})+,)/g, '$1.');
  };
  const fmtDate = d => d ? new Date(d).toLocaleDateString('pt-BR') : '—';
  const fmtDT = d => {
    if (!d) return '—';
    const dt = new Date(d);
    return dt.toLocaleDateString('pt-BR') + ' às ' +
      dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  };
  const mkInitials = n => (n || '?').split(' ').slice(0, 2).map(w => w[0]).join('').toUpperCase();

  // Timeline
  const timeline = [];
  if (quotation.created_at) {
    timeline.push({ type: 'create', label: 'Cotação criada', date: quotation.created_at, by: quotation.creator_name });
  }
  if (quotation.whatsapp_sent_at) {
    timeline.push({ type: 'whatsapp', label: 'WhatsApp enviado ao cliente', date: quotation.whatsapp_sent_at });
  }
  if (quotation.customer_approved_at) {
    const ap = quotation.customer_approved == 1;
    timeline.push({
      type: ap ? 'approved' : 'rejected',
      label: ap ? 'Cliente aprovou a cotação' : 'Cliente recusou a cotação',
      date: quotation.customer_approved_at
    });
  }
  timeline.sort((a, b) => new Date(a.date) - new Date(b.date));
%>

<style>
/* ── Header ─────────────────────────────── */
.cot-header {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 16px 22px;
  margin-bottom: 20px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}
.cot-header-left { display: flex; align-items: flex-start; gap: 14px; flex: 1; min-width: 0; }
.cot-title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }
.cot-customer-row {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  margin-bottom: 5px;
}
.cot-customer-name { font-size: 15px; font-weight: 800; color: #0f172a; }
.cot-wa-link {
  display: inline-flex; align-items: center; gap: 5px;
  color: #16a34a; font-size: 12px; font-weight: 600; text-decoration: none;
  white-space: nowrap; padding: 3px 9px;
  background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px;
  transition: background .15s;
}
.cot-wa-link:hover { background: #dcfce7; }
.cot-meta {
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  font-size: 11.5px; color: #94a3b8;
}
.cot-meta-item { display: flex; align-items: center; gap: 4px; white-space: nowrap; }
.cot-meta-item .material-symbols-outlined { font-size: 14px; }
.cot-meta-sep { color: #e2e8f0; }
.cot-header-actions {
  display: flex; align-items: center; gap: 10px; flex-shrink: 0; flex-wrap: wrap;
  padding-top: 2px;
}

/* ── Tabs ─────────────────────────────── */
.tab-strip {
  display: flex; gap: 4px; margin-bottom: 20px;
  background: #f1f5f9; padding: 4px; border-radius: 10px; width: fit-content;
}
.tab-btn {
  padding: 8px 18px; border: none; background: transparent; border-radius: 7px;
  font-size: 13px; font-weight: 600; color: #64748b; cursor: pointer;
  font-family: inherit; display: flex; align-items: center; gap: 7px;
  transition: background .15s, color .15s; white-space: nowrap;
}
.tab-btn:hover { background: #e2e8f0; color: #334155; }
.tab-btn.tab-active { background: #fff; color: #1d4ed8; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
.tab-dot { width: 7px; height: 7px; border-radius: 50%; background: #f59e0b; flex-shrink: 0; }

.tab-panel { display: none; }
.tab-panel.tab-panel-active { display: block; }

/* ── Tabela de peças ─────────────────── */
.items-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.items-table th {
  padding: 9px 14px; font-size: 10px; font-weight: 700; color: #64748b;
  text-transform: uppercase; letter-spacing: .05em; border-bottom: 2px solid #f1f5f9;
  white-space: nowrap; background: #f8fafc;
}
.items-table td { padding: 11px 14px; border-bottom: 1px solid #f8fafc; vertical-align: middle; }
.items-table tbody tr:last-child td { border-bottom: none; }
.items-table tbody tr:hover td { background: #fafbff; }
.items-table tfoot td {
  padding: 12px 14px; border-top: 2px solid #e2e8f0; background: #f8fafc;
}
.badge { white-space: nowrap; }

/* ── Chat / Observações ─────────────── */
.chat-empty { text-align: center; padding: 28px; color: #94a3b8; font-size: 13px; }
.chat-area { display: flex; flex-direction: column; gap: 14px; }
.chat-msg { display: flex; gap: 10px; align-items: flex-start; }
.chat-msg.right { flex-direction: row-reverse; margin-left: auto; max-width: 75%; }
.chat-msg.left { max-width: 75%; }
.chat-av {
  width: 34px; height: 34px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; color: #fff; flex-shrink: 0;
}
.chat-av.blue  { background: #1d4ed8; }
.chat-av.green { background: #16a34a; }
.chat-content { display: flex; flex-direction: column; gap: 3px; }
.chat-who { font-size: 10.5px; font-weight: 600; color: #64748b; }
.chat-msg.right .chat-who { text-align: right; }
.chat-bubble {
  padding: 10px 14px; border-radius: 12px; font-size: 13px;
  color: #334155; line-height: 1.55;
}
.chat-msg.left  .chat-bubble { background: #eff6ff; border: 1px solid #bfdbfe; border-top-left-radius: 3px; }
.chat-msg.right .chat-bubble { background: #f0fdf4; border: 1px solid #bbf7d0; border-top-right-radius: 3px; }

/* ── Timeline ────────────────────────── */
.tl-wrap { position: relative; padding-left: 28px; display: flex; flex-direction: column; gap: 0; }
.tl-wrap::before {
  content: ''; position: absolute; left: 7px; top: 10px; bottom: 10px;
  width: 2px; background: #e2e8f0;
}
.tl-item { position: relative; padding-bottom: 22px; }
.tl-item:last-child { padding-bottom: 0; }
.tl-dot {
  position: absolute; left: -21px; top: 2px;
  width: 16px; height: 16px; border-radius: 50%;
  border: 2px solid #fff; display: flex; align-items: center; justify-content: center;
}
.tl-dot.create   { background: #e2e8f0; box-shadow: 0 0 0 2px #94a3b8; }
.tl-dot.whatsapp { background: #dcfce7; box-shadow: 0 0 0 2px #16a34a; }
.tl-dot.approved { background: #dcfce7; box-shadow: 0 0 0 2px #16a34a; }
.tl-dot.rejected { background: #fee2e2; box-shadow: 0 0 0 2px #dc2626; }
.tl-label { font-size: 13px; font-weight: 600; color: #0f172a; }
.tl-date  { font-size: 11px; color: #94a3b8; margin-top: 2px; }
.tl-by    { font-size: 11px; color: #64748b; }

/* ── Veículo labels ──────────────────── */
.veh-row { display: flex; gap: 10px; align-items: baseline; margin-bottom: 7px; }
.veh-lbl { font-size: 10px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .06em; min-width: 52px; flex-shrink: 0; }
.veh-val { font-size: 13px; font-weight: 600; color: #0f172a; }

/* ── Resumo Financial ────────────────── */
.resumo-line { display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #64748b; margin-bottom: 8px; }
.resumo-total {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 8px; padding: 12px 14px;
  background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px;
}
.resumo-total span:first-child { font-weight: 700; color: #1e3a8a; font-size: 14px; }
.resumo-total span:last-child  { font-weight: 900; color: #1e3a8a; font-size: 20px; }

/* ── Danger Zone ─────────────────────── */
.danger-zone { border: 1px solid #fecaca; border-radius: 10px; overflow: hidden; margin-top: 24px; }
.danger-zone-hd {
  padding: 12px 18px; background: #fff5f5;
  display: flex; align-items: center; justify-content: space-between;
  cursor: pointer; user-select: none; gap: 8px;
}
.danger-zone-hd:hover { background: #fef2f2; }
.danger-zone-hd span { font-size: 12px; font-weight: 700; color: #dc2626; display: flex; align-items: center; gap: 7px; }
.danger-zone-bd { padding: 16px 18px; border-top: 1px solid #fecaca; display: none; }

/* ── Formulário de preços ────────────── */
.price-block { border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; margin-bottom: 12px; background: #fafbff; }
.price-block-title { font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.price-g4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 8px; margin-bottom: 8px; }
.price-g3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }

/* ── Btn cancel red ──────────────────── */
.btn-danger-outline {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 9px 18px; border: 1.5px solid #fecaca; color: #dc2626;
  border-radius: 8px; font-size: 13px; font-weight: 700;
  background: transparent; cursor: pointer; font-family: inherit;
  transition: background .15s;
}
.btn-danger-outline:hover { background: #fef2f2; }
</style>

<!-- ══════════════════════════════════════════ HEADER ══ -->
<div class="cot-header">
  <div class="cot-header-left">
    <a href="/cotacoes" class="nc-btn-cancel"
       style="padding:7px 12px;font-size:12px;letter-spacing:0;text-transform:none;flex-shrink:0;text-decoration:none;margin-top:3px">
      <i class="bi bi-arrow-left"></i> Voltar
    </a>
    <div style="min-width:0">
      <!-- Linha 1: número + status -->
      <div class="cot-title-row">
        <span style="font-size:18px;font-weight:800;color:#0f172a">Cotação #<%= quotation.quote_number %></span>
        <%- include('../partials/status-badge', { status: quotation.status }) %>
        <% if (quotation.whatsapp_sent_at) { %>
          <span class="badge badge-green" style="white-space:nowrap"><i class="bi bi-whatsapp"></i> Enviado</span>
        <% } %>
      </div>
      <!-- Linha 2: cliente + WhatsApp -->
      <div class="cot-customer-row">
        <span class="cot-customer-name"><%= quotation.customer_name %></span>
        <a href="https://wa.me/<%= quotation.customer_phone.replace(/\D/g,'') %>" target="_blank" class="cot-wa-link">
          <i class="bi bi-whatsapp"></i> <%= quotation.customer_phone %>
        </a>
      </div>
      <!-- Linha 3: metadados -->
      <div class="cot-meta">
        <span class="cot-meta-item">
          <span class="material-symbols-outlined">calendar_month</span>
          <%= fmtDate(quotation.created_at) %>
        </span>
        <span class="cot-meta-sep">·</span>
        <span class="cot-meta-item">
          <span class="material-symbols-outlined">person</span>
          Vendedor: <strong style="color:#64748b"><%= quotation.creator_name %></strong>
        </span>
        <% if (quotation.buyer_name) { %>
        <span class="cot-meta-sep">·</span>
        <span class="cot-meta-item">
          <span class="material-symbols-outlined">shopping_cart</span>
          Compras: <strong style="color:#64748b"><%= quotation.buyer_name %></strong>
        </span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Ação principal (sem cancelar aqui) -->
  <div class="cot-header-actions">
    <% if (canAct && quotation.status === 'pendente') { %>
      <form action="/cotacoes/<%= quotation.id %>/status" method="POST">
        <input type="hidden" name="status" value="em_cotacao">
        <button type="submit" class="nc-btn-send" style="padding:9px 20px">
          <i class="bi bi-search"></i> Iniciar Cotação
        </button>
      </form>
    <% } else if (canAct && quotation.status === 'cotado') { %>
      <form action="/cotacoes/<%= quotation.id %>/peca-chegou" method="POST"
            onsubmit="return confirm('Confirma chegada de todas as peças?')">
        <button type="submit" class="nc-btn-send" style="padding:9px 20px">
          <i class="bi bi-box-arrow-in-down"></i> Confirmar Chegada
        </button>
      </form>
    <% } else if (showClientActions && !quotation.whatsapp_sent_at) { %>
      <button class="nc-btn-send" id="btn-whatsapp" style="padding:9px 20px;background:#16a34a">
        <i class="bi bi-whatsapp"></i> Enviar pelo WhatsApp
      </button>
    <% } else if (showClientActions && quotation.whatsapp_sent_at) { %>
      <span style="font-size:12px;color:#15803d;font-weight:600;white-space:nowrap">
        <i class="bi bi-check-circle-fill"></i> WA enviado em <%= fmtDate(quotation.whatsapp_sent_at) %>
      </span>
    <% } %>
  </div>
</div>

<!-- ══════════════════════════════════════════ TABS ══ -->
<div class="tab-strip">
  <button class="tab-btn <%= defaultTab === 'pecas' ? 'tab-active' : '' %>" onclick="switchTab('pecas',this)">
    <i class="bi bi-box-seam"></i> Peças
    <span style="font-size:11px;font-weight:400;color:#94a3b8">(<%= items.length %>)</span>
  </button>
  <% if (canEdit) { %>
  <button class="tab-btn <%= defaultTab === 'valores' ? 'tab-active' : '' %>" onclick="switchTab('valores',this)">
    <i class="bi bi-pencil-square"></i> Preencher Valores
    <span class="tab-dot"></span>
  </button>
  <% } %>
  <button class="tab-btn" onclick="switchTab('cliente',this)">
    <i class="bi bi-person-vcard"></i> Cliente / Veículo
  </button>
  <button class="tab-btn" onclick="switchTab('historico',this)">
    <i class="bi bi-clock-history"></i> Histórico
  </button>
</div>

<!-- ══════════════════════════════ ABA: PEÇAS ══ -->
<div id="tab-pecas" class="tab-panel <%= defaultTab === 'pecas' ? 'tab-panel-active' : '' %>">

  <!-- Tabela -->
  <div class="nc-card" style="padding:0;overflow:hidden;margin-bottom:16px">
    <div style="overflow-x:auto">
      <table class="items-table">
        <thead>
          <tr>
            <th style="text-align:left">Peça</th>
            <th style="text-align:right">Qtd</th>
            <th style="text-align:right">Vlr Unit.</th>
            <th style="text-align:right">Total</th>
            <th style="text-align:left">Prazo</th>
            <th style="text-align:left">Status</th>
            <% if (currentUser.role === 'compras' || currentUser.role === 'admin') { %>
            <th style="text-align:center">Chegou</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => {
            const iCfg = {
              aguardando:  { l: 'Aguardando', c: 'badge-amber'  },
              em_cotacao:  { l: 'Em Cotação', c: 'badge-blue'   },
              cotado:      { l: 'Cotado',     c: 'badge-green'  },
              peca_chegou: { l: 'Chegou',     c: 'badge-purple' }
            }[item.item_status] || { l: item.item_status, c: 'badge-gray' };
          %>
          <tr>
            <td style="max-width:220px">
              <div style="font-weight:700;color:#0f172a"><%= item.part_name %></div>
              <% if (item.part_code) { %>
                <div style="font-size:11px;color:#94a3b8;margin-top:1px"><%= item.part_code %></div>
              <% } %>
              <% if (item.supplier_name) { %>
                <div style="font-size:11px;color:#64748b">Forn: <%= item.supplier_name %></div>
              <% } %>
              <% if (item.notes) { %>
                <div style="font-size:11px;color:#94a3b8;font-style:italic"><%= item.notes %></div>
              <% } %>
            </td>
            <td style="text-align:right;color:#475569;font-weight:600"><%= item.quantity %></td>
            <td style="text-align:right;color:#475569"><%= fmtBRL(item.unit_price) %></td>
            <td style="text-align:right;font-weight:700;color:#0f172a"><%= fmtBRL(item.total_price) %></td>
            <td style="font-size:12px;color:#64748b;white-space:nowrap">
              <% if (item.delivery_deadline) { %>
                <%= fmtDate(item.delivery_deadline) %>
                <% if (item.delivery_days) { %><br><span style="color:#94a3b8"><%= item.delivery_days %>d</span><% } %>
              <% } else if (item.delivery_days) { %><%= item.delivery_days %> dias
              <% } else { %>—<% } %>
            </td>
            <td><span class="badge <%= iCfg.c %>"><%= iCfg.l %></span></td>
            <% if (currentUser.role === 'compras' || currentUser.role === 'admin') { %>
            <td style="text-align:center">
              <% if (item.item_status !== 'peca_chegou' && quotation.status !== 'cancelado') { %>
              <form action="/cotacoes/<%= quotation.id %>/peca-chegou" method="POST" style="display:inline">
                <input type="hidden" name="item_id" value="<%= item.id %>">
                <button type="submit" class="btn-icon blue" title="Marcar chegada"
                        onclick="return confirm('Confirma chegada desta peça?')">
                  <i class="bi bi-box-arrow-in-down"></i>
                </button>
              </form>
              <% } else { %>
              <i class="bi bi-check-circle-fill" style="color:var(--green);font-size:16px" title="Peça chegou"></i>
              <% } %>
            </td>
            <% } %>
          </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" style="text-align:right;font-size:12px;color:#64748b;font-weight:600">Total Geral</td>
            <td style="text-align:right;font-weight:900;font-size:17px;color:#1e3a8a"><%= fmtBRL(grandTotal) %></td>
            <td colspan="<%= (currentUser.role === 'compras' || currentUser.role === 'admin') ? 3 : 2 %>"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- Observações (chat) -->
  <div class="nc-card">
    <p style="font-size:11px;font-weight:700;color:#334155;text-transform:uppercase;letter-spacing:.06em;margin:0 0 14px">
      Observações
    </p>
    <% if (!quotation.notes_vendas && !quotation.notes_compras) { %>
      <div class="chat-empty">
        <i class="bi bi-chat-square-text" style="font-size:24px;display:block;margin-bottom:8px;color:#cbd5e1"></i>
        Sem observações registradas
      </div>
    <% } else { %>
    <div class="chat-area">
      <% if (quotation.notes_vendas) { %>
      <div class="chat-msg left">
        <div class="chat-av blue"><%= mkInitials(quotation.creator_name) %></div>
        <div class="chat-content">
          <span class="chat-who"><%= quotation.creator_name %> &nbsp;·&nbsp; Vendedor</span>
          <div class="chat-bubble"><%= quotation.notes_vendas %></div>
        </div>
      </div>
      <% } %>
      <% if (quotation.notes_compras) { %>
      <div class="chat-msg right">
        <div class="chat-av green"><%= mkInitials(quotation.buyer_name || 'Compras') %></div>
        <div class="chat-content">
          <span class="chat-who"><%= quotation.buyer_name || 'Compras' %> &nbsp;·&nbsp; Compras</span>
          <div class="chat-bubble"><%= quotation.notes_compras %></div>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>

</div>

<!-- ══════════════════════════ ABA: VALORES ══ -->
<% if (canEdit) { %>
<div id="tab-valores" class="tab-panel <%= defaultTab === 'valores' ? 'tab-panel-active' : '' %>">
  <div class="nc-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:8px">
      <div>
        <p style="font-size:14px;font-weight:700;color:#0f172a;margin:0">Preencher Valores</p>
        <p style="font-size:12px;color:#64748b;margin:3px 0 0"><%= items.length %> <%= items.length === 1 ? 'item' : 'itens' %> para cotar</p>
      </div>
      <span style="font-size:11px;color:#2563eb;background:#eff6ff;padding:4px 12px;border-radius:99px;font-weight:600">
        <i class="bi bi-pencil-fill" style="font-size:9px"></i> Modo edição
      </span>
    </div>

    <form action="/cotacoes/<%= quotation.id %>/responder" method="POST" id="form-responder">
      <!-- Salvar no topo -->
      <button type="submit" class="nc-btn-send" style="width:100%;justify-content:center;margin-bottom:18px">
        <i class="bi bi-check-circle"></i> Salvar e Notificar Vendedor
      </button>

      <% items.forEach((item, idx) => { %>
      <div class="price-block">
        <div class="price-block-title">
          <span style="background:#e0e7ff;color:#3730a3;border-radius:6px;padding:2px 9px;font-size:11px;font-weight:700;flex-shrink:0"><%= idx + 1 %></span>
          <%= item.part_name %>
          <% if (item.part_code) { %><span style="font-weight:400;color:#94a3b8;font-size:12px"><%= item.part_code %></span><% } %>
          <span style="font-weight:400;color:#64748b;font-size:12px;margin-left:auto;white-space:nowrap">Qtd: <strong><%= item.quantity %></strong></span>
        </div>
        <input type="hidden" name="item_ids[]" value="<%= item.id %>">
        <!-- Linha 1: Valores -->
        <div class="price-g4">
          <div>
            <label class="nc-label">Vlr Unit. (R$)</label>
            <input type="number" name="unit_prices[]" class="nc-input" style="font-size:13px;padding:7px 10px"
              value="<%= item.unit_price || '' %>" step="0.01" min="0"
              data-qty="<%= item.quantity %>" data-idx="<%= idx %>">
          </div>
          <div>
            <label class="nc-label">Total (R$)</label>
            <input type="number" name="total_prices[]" class="nc-input" style="font-size:13px;padding:7px 10px"
              value="<%= item.total_price || '' %>" step="0.01" min="0" data-idx="<%= idx %>">
          </div>
          <div>
            <label class="nc-label">M.O. (R$)</label>
            <input type="number" name="labor_costs_compras[]" class="nc-input" style="font-size:13px;padding:7px 10px"
              value="<%= item.labor_cost_compras || 0 %>" step="0.01" min="0">
          </div>
          <div>
            <label class="nc-label">Prazo (dias)</label>
            <input type="number" name="delivery_days[]" class="nc-input" style="font-size:13px;padding:7px 10px"
              value="<%= item.delivery_days || '' %>" min="0">
          </div>
        </div>
        <!-- Linha 2: Logística -->
        <div class="price-g3">
          <div>
            <label class="nc-label">Data Entrega</label>
            <input type="date" name="delivery_deadlines[]" class="nc-input" style="font-size:13px;padding:7px 10px"
              value="<%= item.delivery_deadline ? item.delivery_deadline.substring(0,10) : '' %>">
          </div>
          <div>
            <label class="nc-label">Fornecedor</label>
            <input type="text" name="supplier_names[]" class="nc-input" style="font-size:13px;padding:7px 10px"
              value="<%= item.supplier_name || '' %>" placeholder="Nome do fornecedor">
          </div>
          <div>
            <label class="nc-label">Obs. da Peça</label>
            <input type="text" name="item_notes[]" class="nc-input" style="font-size:13px;padding:7px 10px"
              value="<%= item.notes || '' %>" placeholder="Observação da peça">
          </div>
        </div>
      </div>
      <% }) %>

      <div style="margin-bottom:14px">
        <label class="nc-label">Obs. Internas de Compras</label>
        <textarea name="notes_compras" class="nc-input" rows="3"
                  style="resize:vertical;font-size:13px"
                  placeholder="Observações internas do setor de compras..."><%= quotation.notes_compras || '' %></textarea>
      </div>

      <!-- Salvar no rodapé -->
      <button type="submit" class="nc-btn-send" style="width:100%;justify-content:center">
        <i class="bi bi-check-circle"></i> Salvar e Notificar Vendedor
      </button>
    </form>
  </div>
</div>
<% } %>

<!-- ══════════════════════ ABA: CLIENTE / VEÍCULO ══ -->
<div id="tab-cliente" class="tab-panel">

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;align-items:stretch">

    <!-- Cliente -->
    <div class="nc-card" style="padding:20px">
      <p style="font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.07em;margin:0 0 12px">Cliente</p>
      <p style="font-size:15px;font-weight:800;color:#0f172a;margin:0 0 12px"><%= quotation.customer_name %></p>
      <a href="https://wa.me/<%= quotation.customer_phone.replace(/\D/g,'') %>" target="_blank"
         style="display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:#16a34a;text-decoration:none;padding:8px 14px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;white-space:nowrap">
        <i class="bi bi-whatsapp" style="font-size:15px"></i> <%= quotation.customer_phone %>
      </a>
    </div>

    <!-- Veículo -->
    <div class="nc-card" style="padding:20px">
      <p style="font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.07em;margin:0 0 12px">Veículo</p>
      <div class="veh-row">
        <span class="veh-lbl">Placa</span>
        <span class="plate-tag" style="font-size:12px"><%= quotation.license_plate %></span>
      </div>
      <% if (quotation.make) { %>
      <div class="veh-row">
        <span class="veh-lbl">Marca</span>
        <span class="veh-val"><%= quotation.make %></span>
      </div>
      <% } %>
      <div class="veh-row">
        <span class="veh-lbl">Modelo</span>
        <span class="veh-val"><%= quotation.model || '—' %></span>
      </div>
      <% if (quotation.year_model) { %>
      <div class="veh-row" style="margin-bottom:0">
        <span class="veh-lbl">Ano</span>
        <span class="veh-val"><%= quotation.year_model %></span>
      </div>
      <% } %>
      <% if (quotation.photo_path) { %>
      <a href="<%= quotation.photo_path %>" target="_blank" rel="noopener" style="display:block;margin-top:12px">
        <img src="<%= quotation.photo_path %>" alt="Relatório Técnico"
          style="width:100%;height:90px;object-fit:cover;border-radius:8px;border:1px solid #e2e8f0;cursor:zoom-in;display:block">
      </a>
      <p style="font-size:10px;color:#94a3b8;text-align:center;margin:5px 0 0">Relatório técnico</p>
      <% } %>
    </div>
  </div>

  <!-- Resumo Financeiro -->
  <div class="nc-card" style="padding:20px;margin-bottom:16px">
    <p style="font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.07em;margin:0 0 14px">Resumo Financeiro</p>
    <div class="resumo-line">
      <span>Subtotal peças</span>
      <span style="font-weight:600;color:#334155"><%= fmtBRL(partsTotal) %></span>
    </div>
    <% if (laborTotal > 0) { %>
    <div class="resumo-line">
      <span>Mão de obra</span>
      <span style="font-weight:600;color:#334155"><%= fmtBRL(laborTotal) %></span>
    </div>
    <% } %>
    <div class="resumo-total">
      <span>Total Geral</span>
      <span><%= fmtBRL(grandTotal) %></span>
    </div>
  </div>

  <!-- Resposta do Cliente (vendas/admin) -->
  <% if (showClientActions) { %>
  <div class="nc-card" style="padding:20px">
    <p style="font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.07em;margin:0 0 14px">Resposta do Cliente</p>

    <% if (quotation.customer_approved === null || quotation.customer_approved === undefined) { %>
      <% if (currentUser.role === 'vendas' || currentUser.role === 'admin') { %>
      <p style="font-size:13px;color:#64748b;margin:0 0 14px">O cliente aprovou ou recusou a cotação?</p>
      <div style="display:flex;gap:10px">
        <form action="/cotacoes/<%= quotation.id %>/resposta-cliente" method="POST" style="flex:1">
          <input type="hidden" name="approved" value="1">
          <button type="submit" class="nc-btn-send" style="width:100%;justify-content:center;padding:10px;background:#16a34a"
            onclick="return confirm('Confirmar APROVAÇÃO?')">
            <i class="bi bi-check-circle"></i> Aprovou
          </button>
        </form>
        <form action="/cotacoes/<%= quotation.id %>/resposta-cliente" method="POST" style="flex:1">
          <input type="hidden" name="approved" value="0">
          <button type="submit" class="nc-btn-cancel" style="width:100%;justify-content:center;padding:10px"
            onclick="return confirm('Confirmar RECUSA?')">
            <i class="bi bi-x-circle"></i> Recusou
          </button>
        </form>
      </div>
      <% } else { %>
      <div style="text-align:center;padding:20px;color:#94a3b8">
        <i class="bi bi-hourglass-split" style="font-size:26px;display:block;margin-bottom:8px"></i>
        <span style="font-size:13px">Aguardando resposta do cliente</span>
      </div>
      <% } %>

    <% } else if (quotation.customer_approved == 1) { %>
      <div style="display:flex;align-items:center;gap:10px;padding:14px;background:#f0fdf4;border-radius:8px">
        <i class="bi bi-check-circle-fill" style="color:#16a34a;font-size:22px;flex-shrink:0"></i>
        <div>
          <div style="font-weight:700;color:#16a34a;font-size:14px">Aprovado pelo cliente</div>
          <div style="font-size:11px;color:#64748b"><%= fmtDT(quotation.customer_approved_at) %></div>
        </div>
      </div>
    <% } else { %>
      <div style="display:flex;align-items:center;gap:10px;padding:14px;background:#fef2f2;border-radius:8px">
        <i class="bi bi-x-circle-fill" style="color:#dc2626;font-size:22px;flex-shrink:0"></i>
        <div>
          <div style="font-weight:700;color:#dc2626;font-size:14px">Recusado pelo cliente</div>
          <div style="font-size:11px;color:#64748b"><%= fmtDT(quotation.customer_approved_at) %></div>
        </div>
      </div>
    <% } %>
  </div>
  <% } %>

</div>

<!-- ══════════════════════════ ABA: HISTÓRICO ══ -->
<div id="tab-historico" class="tab-panel">
  <div class="nc-card" style="padding:24px">
    <p style="font-size:11px;font-weight:700;color:#334155;text-transform:uppercase;letter-spacing:.06em;margin:0 0 20px">
      Linha do Tempo
    </p>
    <% if (timeline.length === 0) { %>
      <p style="font-size:13px;color:#94a3b8;text-align:center;padding:20px">Sem eventos registrados.</p>
    <% } else { %>
    <div class="tl-wrap">
      <% timeline.forEach(ev => { %>
      <div class="tl-item">
        <div class="tl-dot <%= ev.type %>"></div>
        <div class="tl-label">
          <% if (ev.type === 'create') { %>
            <i class="bi bi-plus-circle" style="color:#64748b"></i>
          <% } else if (ev.type === 'whatsapp') { %>
            <i class="bi bi-whatsapp" style="color:#16a34a"></i>
          <% } else if (ev.type === 'approved') { %>
            <i class="bi bi-check-circle-fill" style="color:#16a34a"></i>
          <% } else { %>
            <i class="bi bi-x-circle-fill" style="color:#dc2626"></i>
          <% } %>
          <%= ev.label %>
        </div>
        <div class="tl-date"><%= fmtDT(ev.date) %></div>
        <% if (ev.by) { %><div class="tl-by">por <%= ev.by %></div><% } %>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>

<!-- ══════════════════════════ ZONA DE PERIGO ══ -->
<% if (canAct) { %>
<div class="danger-zone">
  <div class="danger-zone-hd" onclick="toggleDanger(this)">
    <span><i class="bi bi-exclamation-triangle"></i> Outras Ações</span>
    <i class="bi bi-chevron-down" id="danger-chevron" style="color:#dc2626;font-size:13px;transition:transform .2s"></i>
  </div>
  <div class="danger-zone-bd" id="danger-body">
    <p style="font-size:12px;color:#64748b;margin:0 0 12px">Atenção: esta ação não pode ser desfeita.</p>
    <form action="/cotacoes/<%= quotation.id %>/status" method="POST"
          onsubmit="return confirm('Tem certeza que deseja cancelar esta cotação? Esta ação não pode ser desfeita.')">
      <input type="hidden" name="status" value="cancelado">
      <button type="submit" class="btn-danger-outline">
        <i class="bi bi-x-circle"></i> Cancelar Cotação
      </button>
    </form>
  </div>
</div>
<% } %>

<script>
function switchTab(name, btn) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('tab-panel-active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('tab-active'));
  document.getElementById('tab-' + name).classList.add('tab-panel-active');
  btn.classList.add('tab-active');
}

function toggleDanger(hd) {
  const body = document.getElementById('danger-body');
  const chevron = document.getElementById('danger-chevron');
  const open = body.style.display === 'block';
  body.style.display = open ? 'none' : 'block';
  chevron.style.transform = open ? '' : 'rotate(180deg)';
}

// Auto-calc: unit × qty → total
document.querySelectorAll('[name="unit_prices[]"]').forEach(input => {
  input.addEventListener('input', () => {
    const idx = input.dataset.idx;
    const qty = parseFloat(input.dataset.qty) || 1;
    const total = document.querySelector(`[name="total_prices[]"][data-idx="${idx}"]`);
    if (total && !total._touched) total.value = (parseFloat(input.value || 0) * qty).toFixed(2);
  });
});
document.querySelectorAll('[name="total_prices[]"]').forEach(input => {
  input.addEventListener('input', () => { input._touched = parseFloat(input.value) > 0; });
});

// WhatsApp
const btnWa = document.getElementById('btn-whatsapp');
if (btnWa) {
  btnWa.addEventListener('click', async () => {
    if (!confirm('Enviar resultado para <%= quotation.customer_name %> (<%= quotation.customer_phone %>)?')) return;
    btnWa.disabled = true;
    btnWa.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Enviando...';
    try {
      const r = await fetch('/api/whatsapp/enviar/<%= quotation.id %>', { method: 'POST' });
      const json = await r.json();
      if (json.ok) {
        btnWa.innerHTML = '<i class="bi bi-check-circle"></i> Enviado!';
        btnWa.style.background = '#15803d';
        showToast('WhatsApp', 'Mensagem enviada!', 'success');
      } else {
        btnWa.disabled = false;
        btnWa.innerHTML = '<i class="bi bi-whatsapp"></i> Enviar pelo WhatsApp';
        showToast('Erro', json.message || 'Erro ao enviar.', 'danger');
      }
    } catch (e) {
      btnWa.disabled = false;
      btnWa.innerHTML = '<i class="bi bi-whatsapp"></i> Enviar pelo WhatsApp';
      showToast('Erro', 'Falha de conexão.', 'danger');
    }
  });
}
</script>
