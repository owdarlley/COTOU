<!-- Header -->
<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap">
  <a href="/cotacoes" class="btn-cancel" style="padding:7px 10px;flex-shrink:0">
    <i class="bi bi-arrow-left"></i>
  </a>
  <div>
    <h4 style="font-size:18px;font-weight:800;margin:0;letter-spacing:-.3px">#<%= quotation.quote_number %></h4>
    <p style="font-size:12px;color:var(--text-muted);margin:2px 0 0">
      Aberta por <strong><%= quotation.creator_name %></strong> em <%= new Date(quotation.created_at).toLocaleString('pt-BR') %>
    </p>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 292px;gap:16px;align-items:start">

  <!-- Left column -->
  <div>

    <!-- Status strip -->
    <div class="status-strip">
      <%- include('../partials/status-badge', { status: quotation.status }) %>
      <% if (quotation.whatsapp_sent_at) { %>
      <span class="badge badge-green"><i class="bi bi-whatsapp"></i> WhatsApp Enviado</span>
      <% } %>
      <div class="status-strip-meta">
        <span><i class="bi bi-calendar3"></i><%= new Date(quotation.created_at).toLocaleDateString('pt-BR') %></span>
        <span><i class="bi bi-person"></i><%= quotation.creator_name %></span>
        <% if (quotation.buyer_name) { %>
        <span><i class="bi bi-bag"></i><%= quotation.buyer_name %></span>
        <% } %>
        <span><i class="bi bi-clock"></i><%= new Date(quotation.updated_at).toLocaleDateString('pt-BR') %></span>
      </div>
    </div>

    <!-- Cliente + Veículo em grid 2 colunas -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">
      <div class="info-card">
        <div class="info-card-header"><i class="bi bi-person-circle"></i>Cliente</div>
        <div class="info-card-body">
          <div class="info-row">
            <span class="info-row-label">Nome</span>
            <span class="info-row-value"><%= quotation.customer_name %></span>
          </div>
          <div class="info-row">
            <span class="info-row-label">Telefone</span>
            <a href="https://wa.me/<%= quotation.customer_phone.replace(/\D/g,'') %>" target="_blank"
               style="font-size:13.5px;font-weight:600;text-decoration:none;color:var(--green)">
              <i class="bi bi-whatsapp"></i> <%= quotation.customer_phone %>
            </a>
          </div>
        </div>
      </div>
      <div class="info-card">
        <div class="info-card-header"><i class="bi bi-car-front"></i>Veículo</div>
        <div class="info-card-body">
          <div class="info-row">
            <span class="info-row-label">Placa</span>
            <span class="plate-tag" style="font-size:13px"><%= quotation.license_plate %></span>
          </div>
          <div class="info-row">
            <span class="info-row-label">Veículo</span>
            <span class="info-row-value"><%= quotation.make || '—' %> <%= quotation.model || '' %></span>
          </div>
          <% if (quotation.year_model) { %>
          <div class="info-row">
            <span class="info-row-label">Ano</span>
            <span class="info-row-value"><%= quotation.year_model %></span>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Peças -->
    <div class="section-card" style="margin-bottom:0">
      <div class="section-head">
        <span class="section-title"><i class="bi bi-box-seam"></i> Peças Solicitadas</span>
      </div>
      <table class="data-table">
        <thead>
          <tr>
            <th>Código</th><th>Peça</th><th>Qtd</th>
            <th>Vlr Unit.</th><th>Total</th><th>M.O.</th>
            <th>Prazo</th><th>Status</th>
            <% if (currentUser.role === 'compras' || currentUser.role === 'admin') { %><th>Chegou</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => { %>
          <tr>
            <td style="color:var(--text-muted);font-size:13px"><%= item.part_code || '—' %></td>
            <td>
              <span style="font-weight:600"><%= item.part_name %></span>
              <% if (item.supplier_name) { %><br><small style="color:var(--text-muted)">Fornecedor: <%= item.supplier_name %></small><% } %>
              <% if (item.notes) { %><br><small style="color:var(--text-muted);font-style:italic"><%= item.notes %></small><% } %>
            </td>
            <td><%= item.quantity %></td>
            <td><%= item.unit_price ? 'R$ ' + item.unit_price.toFixed(2) : '—' %></td>
            <td><strong><%= item.total_price ? 'R$ ' + item.total_price.toFixed(2) : '—' %></strong></td>
            <td><%= item.labor_cost_compras ? 'R$ ' + item.labor_cost_compras.toFixed(2) : '—' %></td>
            <td style="font-size:13px">
              <% if (item.delivery_deadline) { %>
                <%= new Date(item.delivery_deadline).toLocaleDateString('pt-BR') %>
                <% if (item.delivery_days) { %><br><small style="color:var(--text-muted)"><%= item.delivery_days %> dias</small><% } %>
              <% } else if (item.delivery_days) { %><%= item.delivery_days %> dias
              <% } else { %>—<% } %>
            </td>
            <td>
              <% const iCfg = {
                aguardando: { l:'Aguardando', c:'badge-amber'  },
                em_cotacao: { l:'Em Cotação', c:'badge-blue'   },
                cotado:     { l:'Cotado',     c:'badge-green'  },
                peca_chegou:{ l:'Chegou',     c:'badge-purple' }
              }[item.item_status] || { l: item.item_status, c: 'badge-gray' }; %>
              <span class="badge <%= iCfg.c %>"><%= iCfg.l %></span>
            </td>
            <% if (currentUser.role === 'compras' || currentUser.role === 'admin') { %>
            <td>
              <% if (item.item_status !== 'peca_chegou' && quotation.status !== 'cancelado') { %>
              <form action="/cotacoes/<%= quotation.id %>/peca-chegou" method="POST" style="display:inline">
                <input type="hidden" name="item_id" value="<%= item.id %>">
                <button type="submit" class="btn-icon blue" title="Marcar como chegou"
                  onclick="return confirm('Confirma que a peça chegou?')">
                  <i class="bi bi-box-arrow-in-down"></i>
                </button>
              </form>
              <% } else { %>
              <i class="bi bi-check-circle-fill" style="color:var(--green);font-size:18px"></i>
              <% } %>
            </td>
            <% } %>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <div style="background:var(--bg);border-top:1px solid var(--border);padding:14px 16px">
        <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--text-muted);padding:3px 0">
          <span>Subtotal peças</span><span>R$ <%= partsTotal.toFixed(2) %></span>
        </div>
        <% if (laborTotal > 0) { %>
        <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--text-muted);padding:3px 0">
          <span>Mão de obra</span><span>R$ <%= laborTotal.toFixed(2) %></span>
        </div>
        <% } %>
        <div style="display:flex;justify-content:space-between;font-weight:800;font-size:15px;color:var(--text);border-top:1px solid var(--border);margin-top:6px;padding-top:10px">
          <span>Total Geral</span><span>R$ <%= grandTotal.toFixed(2) %></span>
        </div>
      </div>
    </div>

    <!-- Observações -->
    <% if (quotation.notes_vendas || quotation.notes_compras) { %>
    <div class="form-section" style="margin-top:14px">
      <div class="form-section-header"><i class="bi bi-chat-text"></i> Observações</div>
      <div class="form-section-body">
        <% if (quotation.notes_vendas) { %>
        <div style="margin-bottom:10px">
          <span class="role-badge role-vendas" style="margin-right:8px">Vendas</span>
          <%= quotation.notes_vendas %>
        </div>
        <% } %>
        <% if (quotation.notes_compras) { %>
        <div>
          <span class="role-badge role-compras" style="margin-right:8px">Compras</span>
          <%= quotation.notes_compras %>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- Relatório Técnico (foto) -->
    <% if (quotation.photo_path) { %>
    <div class="form-section" style="margin-top:14px">
      <div class="form-section-header"><i class="bi bi-camera"></i> Relatório Técnico</div>
      <div class="form-section-body" style="padding:12px">
        <a href="<%= quotation.photo_path %>" target="_blank" rel="noopener">
          <img src="<%= quotation.photo_path %>" alt="Foto da peça"
            style="max-width:100%;border-radius:8px;border:1px solid var(--border);cursor:zoom-in;display:block">
        </a>
        <p style="font-size:11px;color:var(--text-muted);margin-top:8px;text-align:center">
          Clique na imagem para ampliar
        </p>
      </div>
    </div>
    <% } %>

  </div>

  <!-- Right column: actions -->
  <div>

    <!-- AÇÕES: COMPRAS -->
    <% if ((currentUser.role === 'compras' || currentUser.role === 'admin') && quotation.status !== 'cancelado') { %>

    <% if (quotation.status === 'pendente') { %>
    <div class="action-card">
      <div class="action-card-header blue"><i class="bi bi-search"></i>Iniciar Cotação</div>
      <div class="action-card-body">
        <p style="font-size:12.5px;color:var(--text-muted);margin-bottom:12px;line-height:1.5">Clique para assumir esta cotação e iniciar a busca de preços.</p>
        <form action="/cotacoes/<%= quotation.id %>/status" method="POST">
          <input type="hidden" name="status" value="em_cotacao">
          <button type="submit" class="btn-blue"><i class="bi bi-search"></i>Em Cotação</button>
        </form>
      </div>
    </div>
    <% } %>

    <% if (quotation.status === 'em_cotacao' || quotation.status === 'cotado') { %>
    <div class="action-card">
      <div class="action-card-header blue"><i class="bi bi-currency-dollar"></i>Responder Cotação</div>
      <div class="action-card-body">
        <form action="/cotacoes/<%= quotation.id %>/responder" method="POST">
          <% items.forEach((item, idx) => { %>
          <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:12px;margin-bottom:12px">
            <div style="font-size:13px;font-weight:600;margin-bottom:10px">
              <%= item.part_name %><% if (item.part_code) { %> (<%= item.part_code %>)<% } %> — Qtd: <%= item.quantity %>
            </div>
            <input type="hidden" name="item_ids[]" value="<%= item.id %>">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
              <div>
                <label class="form-label" style="font-size:10px">Vlr Unit. (R$)</label>
                <input type="number" name="unit_prices[]" class="form-control form-control-sm"
                  value="<%= item.unit_price || '' %>" step="0.01" min="0"
                  data-qty="<%= item.quantity %>" data-idx="<%= idx %>" class="unit-price">
              </div>
              <div>
                <label class="form-label" style="font-size:10px">Vlr Total (R$)</label>
                <input type="number" name="total_prices[]" class="form-control form-control-sm"
                  value="<%= item.total_price || '' %>" step="0.01" min="0" data-idx="<%= idx %>">
              </div>
              <div>
                <label class="form-label" style="font-size:10px">Mão de Obra (R$)</label>
                <input type="number" name="labor_costs_compras[]" class="form-control form-control-sm"
                  value="<%= item.labor_cost_compras || 0 %>" step="0.01" min="0">
              </div>
              <div>
                <label class="form-label" style="font-size:10px">Prazo (dias)</label>
                <input type="number" name="delivery_days[]" class="form-control form-control-sm"
                  value="<%= item.delivery_days || '' %>" min="0">
              </div>
              <div>
                <label class="form-label" style="font-size:10px">Data Entrega</label>
                <input type="date" name="delivery_deadlines[]" class="form-control form-control-sm"
                  value="<%= item.delivery_deadline ? item.delivery_deadline.substring(0,10) : '' %>">
              </div>
              <div>
                <label class="form-label" style="font-size:10px">Fornecedor</label>
                <input type="text" name="supplier_names[]" class="form-control form-control-sm"
                  value="<%= item.supplier_name || '' %>">
              </div>
              <div style="grid-column:span 2">
                <label class="form-label" style="font-size:10px">Obs. do item</label>
                <input type="text" name="item_notes[]" class="form-control form-control-sm"
                  value="<%= item.notes || '' %>">
              </div>
            </div>
          </div>
          <% }) %>
          <div style="margin-bottom:12px">
            <label class="form-label">Obs. Compras</label>
            <textarea name="notes_compras" class="form-control form-control-sm" rows="2"><%= quotation.notes_compras || '' %></textarea>
          </div>
          <button type="submit" class="btn-green">
            <i class="bi bi-check-circle"></i>Salvar e Notificar
          </button>
        </form>
      </div>
    </div>
    <% } %>

    <% if (quotation.status === 'cotado') { %>
    <div class="action-card">
      <div class="action-card-header purple"><i class="bi bi-box-arrow-in-down"></i>Peça Chegou</div>
      <div class="action-card-body">
        <p style="font-size:12.5px;color:var(--text-muted);margin-bottom:12px;line-height:1.5">Confirme a chegada e o vendedor será notificado.</p>
        <form action="/cotacoes/<%= quotation.id %>/peca-chegou" method="POST"
          onsubmit="return confirm('Confirma que todas as peças chegaram?')">
          <button type="submit" class="btn-blue"><i class="bi bi-box-arrow-in-down"></i>Confirmar Chegada</button>
        </form>
      </div>
    </div>
    <% } %>

    <div class="action-card">
      <div class="action-card-body">
        <form action="/cotacoes/<%= quotation.id %>/status" method="POST"
          onsubmit="return confirm('Cancelar esta cotação?')">
          <input type="hidden" name="status" value="cancelado">
          <button type="submit" class="btn-red-outline"><i class="bi bi-x-circle"></i>Cancelar Cotação</button>
        </form>
      </div>
    </div>

    <% } %>

    <!-- AÇÕES: VENDAS -->
    <% if ((currentUser.role === 'vendas' || currentUser.role === 'admin') && (quotation.status === 'cotado' || quotation.status === 'peca_chegou')) { %>
    <div class="action-card">
      <div class="action-card-header green"><i class="bi bi-whatsapp"></i>Notificar Cliente</div>
      <div class="action-card-body">
        <p style="font-size:12.5px;color:var(--text-muted);margin-bottom:12px;line-height:1.5">
          Envie o resultado por WhatsApp para <strong><%= quotation.customer_name %></strong>.
        </p>
        <button class="btn-wa" id="btn-whatsapp" <%= quotation.whatsapp_sent_at ? 'disabled' : '' %>>
          <i class="bi bi-whatsapp"></i>
          <%= quotation.whatsapp_sent_at ? 'WhatsApp já enviado' : 'Enviar pelo WhatsApp' %>
        </button>
        <% if (quotation.whatsapp_sent_at) { %>
        <p style="font-size:12px;color:var(--text-muted);text-align:center;margin-top:8px">
          Enviado em <%= new Date(quotation.whatsapp_sent_at).toLocaleString('pt-BR') %>
        </p>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- Resposta do Cliente -->
    <% if (quotation.status === 'cotado' || quotation.status === 'peca_chegou') { %>
    <div class="action-card">
      <div class="action-card-header" style="background:#f1f5f9;color:var(--text)"><i class="bi bi-person-check"></i>Resposta do Cliente</div>
      <div class="action-card-body">
        <% if (quotation.customer_approved === null || quotation.customer_approved === undefined) { %>
          <% if (currentUser.role === 'vendas' || currentUser.role === 'admin') { %>
          <p style="font-size:12.5px;color:var(--text-muted);margin-bottom:12px;line-height:1.5">O cliente aprovou ou recusou?</p>
          <form action="/cotacoes/<%= quotation.id %>/resposta-cliente" method="POST">
            <input type="hidden" name="approved" value="1">
            <button type="submit" class="btn-green" style="margin-bottom:8px"
              onclick="return confirm('Confirmar que o cliente APROVOU?')">
              <i class="bi bi-check-circle"></i>Cliente Aprovou
            </button>
          </form>
          <form action="/cotacoes/<%= quotation.id %>/resposta-cliente" method="POST">
            <input type="hidden" name="approved" value="0">
            <button type="submit" class="btn-red-outline"
              onclick="return confirm('Confirmar que o cliente RECUSOU?')">
              <i class="bi bi-x-circle"></i>Cliente Recusou
            </button>
          </form>
          <% } else { %>
          <div style="text-align:center;padding:12px;color:var(--text-muted)">
            <i class="bi bi-hourglass-split" style="font-size:24px;display:block;margin-bottom:8px"></i>
            <span style="font-size:13px">Aguardando resposta do cliente</span>
          </div>
          <% } %>
        <% } else if (quotation.customer_approved == 1) { %>
          <div style="display:flex;align-items:center;gap:10px;padding:12px;background:var(--green-light);border-radius:8px">
            <i class="bi bi-check-circle-fill" style="color:var(--green);font-size:24px;flex-shrink:0"></i>
            <div>
              <div style="font-weight:700;color:var(--green)">Aprovado — Pode encomendar</div>
              <% if (quotation.customer_approved_at) { %><div style="font-size:12px;color:var(--text-muted)"><%= new Date(quotation.customer_approved_at).toLocaleString('pt-BR') %></div><% } %>
            </div>
          </div>
        <% } else { %>
          <div style="display:flex;align-items:center;gap:10px;padding:12px;background:var(--red-light);border-radius:8px">
            <i class="bi bi-x-circle-fill" style="color:var(--red);font-size:24px;flex-shrink:0"></i>
            <div>
              <div style="font-weight:700;color:var(--red)">Recusado — Não encomendar</div>
              <% if (quotation.customer_approved_at) { %><div style="font-size:12px;color:var(--text-muted)"><%= new Date(quotation.customer_approved_at).toLocaleString('pt-BR') %></div><% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
    <% } %>

  </div>
</div>

<script>
const btn = document.getElementById('btn-whatsapp');
if (btn && !btn.disabled) {
  btn.addEventListener('click', async () => {
    if (!confirm('Enviar resultado da cotação para <%= quotation.customer_name %> (<%= quotation.customer_phone %>)?')) return;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enviando...';
    try {
      const r = await fetch('/api/whatsapp/enviar/<%= quotation.id %>', { method: 'POST' });
      const json = await r.json();
      if (json.ok) {
        btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Enviado!';
        btn.style.background = '#15803d';
        showToast('WhatsApp', 'Mensagem enviada!', 'success');
      } else {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-whatsapp me-1"></i>Enviar pelo WhatsApp';
        showToast('Erro', json.message || 'Erro ao enviar.', 'danger');
      }
    } catch (e) {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-whatsapp me-1"></i>Enviar pelo WhatsApp';
      showToast('Erro', 'Falha de conexão.', 'danger');
    }
  });
}

document.querySelectorAll('.unit-price').forEach(input => {
  input.addEventListener('input', () => {
    const idx = input.dataset.idx;
    const qty = parseFloat(input.dataset.qty) || 1;
    const total = document.querySelector(`[name="total_prices[]"][data-idx="${idx}"]`);
    if (total && !total._touched) total.value = (parseFloat(input.value || 0) * qty).toFixed(2);
  });
});
document.querySelectorAll('[name="total_prices[]"]').forEach(input => {
  input.addEventListener('input', () => { input._touched = parseFloat(input.value) > 0; });
});
</script>
