<div class="row g-4">
  <div class="col-12">
    <div class="d-flex align-items-center gap-3 mb-2">
      <a href="/cotacoes" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
      <h4 class="fw-bold mb-0">Cotação #<%= quotation.quote_number %></h4>
      <%- include('../partials/status-badge', { status: quotation.status }) %>
      <% if (quotation.whatsapp_sent_at) { %>
        <span class="badge bg-success"><i class="bi bi-whatsapp me-1"></i>WhatsApp Enviado</span>
      <% } %>
    </div>
    <small class="text-muted">Aberta por <strong><%= quotation.creator_name %></strong> em <%= new Date(quotation.created_at).toLocaleString('pt-BR') %></small>
    <% if (quotation.buyer_name) { %>
    <small class="text-muted ms-3">| Comprador: <strong><%= quotation.buyer_name %></strong></small>
    <% } %>
  </div>

  <!-- Coluna principal -->
  <div class="col-lg-8">

    <!-- Cliente -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold"><i class="bi bi-person me-2 text-primary"></i>Cliente</div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6"><label class="text-muted small">Nome</label><div class="fw-semibold"><%= quotation.customer_name %></div></div>
          <div class="col-md-6"><label class="text-muted small">Telefone</label>
            <div class="fw-semibold">
              <a href="https://wa.me/<%= quotation.customer_phone.replace(/\D/g,'') %>" target="_blank" class="text-decoration-none">
                <i class="bi bi-whatsapp text-success me-1"></i><%= quotation.customer_phone %>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Veículo -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold"><i class="bi bi-car-front me-2 text-primary"></i>Veículo</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-3"><label class="text-muted small">Placa</label><div class="fw-bold fs-5"><%= quotation.license_plate %></div></div>
          <div class="col-md-4"><label class="text-muted small">Marca / Modelo</label><div class="fw-semibold"><%= quotation.make || '—' %> <%= quotation.model || '' %></div></div>
          <div class="col-md-3"><label class="text-muted small">Ano</label><div><%= quotation.year_model || '—' %></div></div>
          <div class="col-md-2"><label class="text-muted small">Cor</label><div><%= quotation.color || '—' %></div></div>
        </div>
      </div>
    </div>

    <!-- Peças -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold"><i class="bi bi-box-seam me-2 text-primary"></i>Peças Solicitadas</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table mb-0">
            <thead class="table-light">
              <tr>
                <th>Código</th><th>Peça</th><th>Qtd</th>
                <th>Vlr Unit.</th><th>Total</th><th>M.O. Compras</th>
                <th>M.O. Vendas</th><th>Prazo</th><th>Status</th>
                <% if (currentUser.role === 'compras' || currentUser.role === 'admin') { %><th>Chegou</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(item => { %>
              <tr>
                <td class="text-muted small"><%= item.part_code || '—' %></td>
                <td>
                  <span class="fw-semibold"><%= item.part_name %></span>
                  <% if (item.supplier_name) { %><br><small class="text-muted">Fornecedor: <%= item.supplier_name %></small><% } %>
                  <% if (item.notes) { %><br><small class="text-muted fst-italic"><%= item.notes %></small><% } %>
                </td>
                <td><%= item.quantity %></td>
                <td><%= item.unit_price ? 'R$ ' + item.unit_price.toFixed(2) : '—' %></td>
                <td><strong><%= item.total_price ? 'R$ ' + item.total_price.toFixed(2) : '—' %></strong></td>
                <td><%= item.labor_cost_compras ? 'R$ ' + item.labor_cost_compras.toFixed(2) : '—' %></td>
                <td><%= item.labor_cost_vendas ? 'R$ ' + item.labor_cost_vendas.toFixed(2) : '—' %></td>
                <td>
                  <% if (item.delivery_deadline) { %>
                    <%= new Date(item.delivery_deadline).toLocaleDateString('pt-BR') %>
                    <% if (item.delivery_days) { %><br><small class="text-muted"><%= item.delivery_days %> dias</small><% } %>
                  <% } else if (item.delivery_days) { %>
                    <%= item.delivery_days %> dias
                  <% } else { %>—<% } %>
                </td>
                <td>
                  <% const iCfg = { aguardando:{l:'Aguardando',c:'warning text-dark'}, em_cotacao:{l:'Em Cotação',c:'info text-dark'}, cotado:{l:'Cotado',c:'success'}, peca_chegou:{l:'Chegou',c:'primary'} }[item.item_status] || {l:item.item_status,c:'secondary'}; %>
                  <span class="badge bg-<%= iCfg.c %>"><%= iCfg.l %></span>
                  <% if (item.arrived_at) { %><br><small class="text-muted"><%= new Date(item.arrived_at).toLocaleDateString('pt-BR') %></small><% } %>
                </td>
                <% if (currentUser.role === 'compras' || currentUser.role === 'admin') { %>
                <td>
                  <% if (item.item_status !== 'peca_chegou' && quotation.status !== 'cancelado') { %>
                  <form action="/cotacoes/<%= quotation.id %>/peca-chegou" method="POST" class="d-inline">
                    <input type="hidden" name="item_id" value="<%= item.id %>">
                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Marcar como chegou"
                      onclick="return confirm('Confirma que a peça chegou?')">
                      <i class="bi bi-box-arrow-in-down"></i>
                    </button>
                  </form>
                  <% } else { %>
                  <i class="bi bi-check-circle-fill text-success fs-5"></i>
                  <% } %>
                </td>
                <% } %>
              </tr>
              <% }) %>
            </tbody>
            <tfoot class="table-light fw-semibold">
              <tr>
                <td colspan="4" class="text-end">Subtotal Peças:</td>
                <td>R$ <%= partsTotal.toFixed(2) %></td>
                <td colspan="5"></td>
              </tr>
              <% if (laborTotal > 0) { %>
              <tr>
                <td colspan="4" class="text-end">Total Mão de Obra:</td>
                <td>R$ <%= laborTotal.toFixed(2) %></td>
                <td colspan="5"></td>
              </tr>
              <% } %>
              <tr class="table-success">
                <td colspan="4" class="text-end fw-bold">TOTAL GERAL:</td>
                <td class="fw-bold">R$ <%= grandTotal.toFixed(2) %></td>
                <td colspan="5"></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- Observações -->
    <% if (quotation.notes_vendas || quotation.notes_compras) { %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold"><i class="bi bi-chat-text me-2"></i>Observações</div>
      <div class="card-body">
        <% if (quotation.notes_vendas) { %>
        <div class="mb-2"><span class="badge bg-info text-dark me-2">Vendas</span><%= quotation.notes_vendas %></div>
        <% } %>
        <% if (quotation.notes_compras) { %>
        <div><span class="badge bg-success me-2">Compras</span><%= quotation.notes_compras %></div>
        <% } %>
      </div>
    </div>
    <% } %>

  </div>

  <!-- Coluna de ações -->
  <div class="col-lg-4">

    <!-- AÇÕES: COMPRAS -->
    <% if ((currentUser.role === 'compras' || currentUser.role === 'admin') && quotation.status !== 'cancelado') { %>

    <% if (quotation.status === 'pendente') { %>
    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-info">
      <div class="card-body">
        <h6 class="fw-semibold"><i class="bi bi-search me-2 text-info"></i>Iniciar Cotação</h6>
        <p class="small text-muted">Clique para assumir esta cotação e iniciar a busca de preços.</p>
        <form action="/cotacoes/<%= quotation.id %>/status" method="POST">
          <input type="hidden" name="status" value="em_cotacao">
          <button type="submit" class="btn btn-info w-100 fw-semibold">
            <i class="bi bi-search me-1"></i>Em Cotação
          </button>
        </form>
      </div>
    </div>
    <% } %>

    <% if (quotation.status === 'em_cotacao' || quotation.status === 'cotado') { %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold"><i class="bi bi-currency-dollar me-2 text-success"></i>Preencher Valores</div>
      <div class="card-body">
        <form action="/cotacoes/<%= quotation.id %>/responder" method="POST">
          <% items.forEach((item, idx) => { %>
          <div class="card bg-light mb-3 p-2">
            <div class="fw-semibold small mb-2"><%= item.part_name %> <%= item.part_code ? `(${item.part_code})` : '' %> — Qtd: <%= item.quantity %></div>
            <input type="hidden" name="item_ids[]" value="<%= item.id %>">
            <div class="row g-2">
              <div class="col-6">
                <label class="form-label form-label-sm">Vlr Unit. (R$)</label>
                <input type="number" name="unit_prices[]" class="form-control form-control-sm unit-price"
                  value="<%= item.unit_price || '' %>" step="0.01" min="0"
                  data-qty="<%= item.quantity %>" data-idx="<%= idx %>">
              </div>
              <div class="col-6">
                <label class="form-label form-label-sm">Vlr Total (R$)</label>
                <input type="number" name="total_prices[]" class="form-control form-control-sm total-price"
                  value="<%= item.total_price || '' %>" step="0.01" min="0" data-idx="<%= idx %>">
              </div>
              <div class="col-6">
                <label class="form-label form-label-sm">Mão de Obra (R$)</label>
                <input type="number" name="labor_costs_compras[]" class="form-control form-control-sm"
                  value="<%= item.labor_cost_compras || 0 %>" step="0.01" min="0">
              </div>
              <div class="col-6">
                <label class="form-label form-label-sm">Prazo (dias)</label>
                <input type="number" name="delivery_days[]" class="form-control form-control-sm"
                  value="<%= item.delivery_days || '' %>" min="0">
              </div>
              <div class="col-6">
                <label class="form-label form-label-sm">Data Entrega</label>
                <input type="date" name="delivery_deadlines[]" class="form-control form-control-sm"
                  value="<%= item.delivery_deadline ? item.delivery_deadline.substring(0,10) : '' %>">
              </div>
              <div class="col-6">
                <label class="form-label form-label-sm">Fornecedor</label>
                <input type="text" name="supplier_names[]" class="form-control form-control-sm"
                  value="<%= item.supplier_name || '' %>">
              </div>
              <div class="col-12">
                <label class="form-label form-label-sm">Obs. do item</label>
                <input type="text" name="item_notes[]" class="form-control form-control-sm"
                  value="<%= item.notes || '' %>">
              </div>
            </div>
          </div>
          <% }) %>
          <div class="mb-3">
            <label class="form-label fw-semibold small">Observações Compras</label>
            <textarea name="notes_compras" class="form-control form-control-sm" rows="2"><%= quotation.notes_compras || '' %></textarea>
          </div>
          <button type="submit" class="btn btn-success w-100 fw-semibold">
            <i class="bi bi-check-circle me-1"></i>Salvar e Notificar Vendedor
          </button>
        </form>
      </div>
    </div>
    <% } %>

    <% if (quotation.status === 'cotado') { %>
    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-primary">
      <div class="card-body">
        <h6 class="fw-semibold"><i class="bi bi-box-arrow-in-down me-2 text-primary"></i>Registrar Chegada</h6>
        <p class="small text-muted">Marque quando TODAS as peças chegarem. O vendedor será notificado.</p>
        <form action="/cotacoes/<%= quotation.id %>/peca-chegou" method="POST"
          onsubmit="return confirm('Confirma que todas as peças desta cotação chegaram?')">
          <button type="submit" class="btn btn-primary w-100 fw-semibold">
            <i class="bi bi-box-arrow-in-down me-1"></i>Todas as Peças Chegaram
          </button>
        </form>
      </div>
    </div>
    <% } %>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <form action="/cotacoes/<%= quotation.id %>/status" method="POST"
          onsubmit="return confirm('Cancelar esta cotação?')">
          <input type="hidden" name="status" value="cancelado">
          <button type="submit" class="btn btn-outline-danger btn-sm w-100">
            <i class="bi bi-x-circle me-1"></i>Cancelar Cotação
          </button>
        </form>
      </div>
    </div>

    <% } %>

    <!-- AÇÕES: VENDAS -->
    <% if ((currentUser.role === 'vendas' || currentUser.role === 'admin') && quotation.status === 'cotado' || quotation.status === 'peca_chegou') { %>
    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-success">
      <div class="card-body">
        <h6 class="fw-semibold"><i class="bi bi-whatsapp me-2 text-success"></i>Notificar Cliente</h6>
        <p class="small text-muted">Envie o resultado da cotação por WhatsApp para <strong><%= quotation.customer_name %></strong>.</p>
        <button class="btn btn-success w-100 fw-semibold" id="btn-whatsapp" <%= quotation.whatsapp_sent_at ? 'disabled' : '' %>>
          <i class="bi bi-whatsapp me-1"></i>
          <%= quotation.whatsapp_sent_at ? 'WhatsApp já enviado' : 'Enviar pelo WhatsApp' %>
        </button>
        <% if (quotation.whatsapp_sent_at) { %>
        <div class="text-muted small text-center mt-1">
          Enviado em <%= new Date(quotation.whatsapp_sent_at).toLocaleString('pt-BR') %>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- Info geral -->
    <div class="card border-0 shadow-sm">
      <div class="card-body small text-muted">
        <div class="d-flex justify-content-between mb-1">
          <span>Vendedor:</span><strong class="text-dark"><%= quotation.creator_name %></strong>
        </div>
        <% if (quotation.buyer_name) { %>
        <div class="d-flex justify-content-between mb-1">
          <span>Comprador:</span><strong class="text-dark"><%= quotation.buyer_name %></strong>
        </div>
        <% } %>
        <div class="d-flex justify-content-between mb-1">
          <span>Abertura:</span><strong class="text-dark"><%= new Date(quotation.created_at).toLocaleString('pt-BR') %></strong>
        </div>
        <div class="d-flex justify-content-between">
          <span>Atualização:</span><strong class="text-dark"><%= new Date(quotation.updated_at).toLocaleString('pt-BR') %></strong>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
const btn = document.getElementById('btn-whatsapp');
if (btn && !btn.disabled) {
  btn.addEventListener('click', async () => {
    if (!confirm('Enviar resultado da cotação para <%= quotation.customer_name %> (<%=quotation.customer_phone %>)?')) return;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enviando...';
    try {
      const r = await fetch('/api/whatsapp/enviar/<%= quotation.id %>', { method: 'POST' });
      const json = await r.json();
      if (json.ok) {
        btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Enviado com sucesso!';
        btn.className = 'btn btn-outline-success w-100';
        showToast('WhatsApp', 'Mensagem enviada para o cliente!', 'success');
      } else {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-whatsapp me-1"></i>Enviar pelo WhatsApp';
        showToast('Erro', json.message || 'Erro ao enviar.', 'danger');
      }
    } catch (e) {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-whatsapp me-1"></i>Enviar pelo WhatsApp';
      showToast('Erro', 'Falha de conexão.', 'danger');
    }
  });
}

// Auto-calc total price from unit * qty
document.querySelectorAll('.unit-price').forEach(input => {
  input.addEventListener('input', () => {
    const idx = input.dataset.idx;
    const qty = parseFloat(input.dataset.qty) || 1;
    const total = document.querySelector(`.total-price[data-idx="${idx}"]`);
    if (total && !total._touched) {
      total.value = (parseFloat(input.value || 0) * qty).toFixed(2);
    }
  });
});
document.querySelectorAll('.total-price').forEach(input => {
  input.addEventListener('input', () => { input._touched = parseFloat(input.value) > 0; });
});
</script>
