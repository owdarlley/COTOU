<%
  function initials(name){ return (name||'?').split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase(); }
  function fmtBRL(v){ if(v==null) return '—'; return 'R$ ' + parseFloat(v).toFixed(2).replace('.',',').replace(/(\d)(?=(\d{3})+,)/g,'$1.'); }
  function fmtDate(d){ return d ? new Date(d).toLocaleDateString('pt-BR') : '—'; }
  function fmtDT(d){
    if(!d) return '—';
    const dt = new Date(d);
    return dt.toLocaleDateString('pt-BR') + ' às ' + dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  }

  const canEdit = (currentUser.role === 'compras' || currentUser.role === 'admin') &&
                  (quotation.status === 'em_cotacao' || quotation.status === 'cotado') &&
                  quotation.status !== 'cancelado';
  const canAct = (currentUser.role === 'compras' || currentUser.role === 'admin') && quotation.status !== 'cancelado';
  const isVendas = currentUser.role === 'vendas' || currentUser.role === 'admin';
  const showClientActions = isVendas && (quotation.status === 'cotado' || quotation.status === 'peca_chegou');
  const defaultTab = canEdit && quotation.status === 'em_cotacao' ? 'valores' : 'pecas';

  // Build timeline
  const timeline = [];
  timeline.push({ type: 'create', tone: 'gray', label: 'Cotação criada', date: quotation.created_at, by: quotation.creator_name, icon: 'plus-circle' });
  if (quotation.status === 'em_cotacao' || quotation.status === 'cotado' || quotation.status === 'peca_chegou') {
    timeline.push({ type: 'assume', tone: 'blue', label: 'Comprador assumiu', date: quotation.assumed_at || quotation.updated_at, by: quotation.buyer_name, icon: 'search' });
  }
  if (quotation.status === 'cotado' || quotation.status === 'peca_chegou') {
    timeline.push({ type: 'cotado', tone: 'green', label: 'Valores preenchidos', date: quotation.responded_at || quotation.updated_at, by: quotation.buyer_name, icon: 'check-circle' });
  }
  if (quotation.whatsapp_sent_at) timeline.push({ type: 'wa', tone: 'green', label: 'WhatsApp enviado ao cliente', date: quotation.whatsapp_sent_at, by: quotation.creator_name, icon: 'whatsapp' });
  if (quotation.customer_approved === 1) timeline.push({ type: 'aprov', tone: 'green', label: 'Cliente aprovou', date: quotation.customer_approved_at, by: quotation.customer_name, icon: 'check2-circle' });
  if (quotation.customer_approved === 0) timeline.push({ type: 'rejec', tone: 'red', label: 'Cliente recusou', date: quotation.customer_approved_at, by: quotation.customer_name, icon: 'x-circle' });
  if (quotation.status === 'peca_chegou') timeline.push({ type: 'chegou', tone: 'violet', label: 'Peça chegou ao estoque', date: quotation.peca_chegou_at || quotation.updated_at, by: quotation.buyer_name, icon: 'box-seam' });
  timeline.sort((a,b) => new Date(a.date) - new Date(b.date));
%>

<div class="page">

<!-- ─── HEADER ──────────────────────────────────────────── -->
<div class="detail-header">
  <a href="/cotacoes" style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--text-2);font-weight:600;margin-bottom:14px">
    <i class="bi bi-arrow-left"></i> Voltar para cotações
  </a>

  <!-- Top: título + ações -->
  <div class="detail-top">
    <div class="detail-title-row">
      <span class="detail-num">Cotação <span class="mono">#<%= quotation.quote_number %></span></span>
      <%- include('../partials/status-badge', { status: quotation.status }) %>
      <% if (quotation.whatsapp_sent_at) { %>
        <span class="status cotado"><i class="bi bi-whatsapp"></i> Enviado WA</span>
      <% } %>
    </div>

    <div class="detail-actions">
      <% if (canAct && quotation.status === 'pendente') { %>
        <form action="/cotacoes/<%= quotation.id %>/status" method="POST" style="margin:0">
          <input type="hidden" name="status" value="em_cotacao">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Assumir Cotação
          </button>
        </form>
      <% } else if (canAct && quotation.status === 'cotado') { %>
        <form action="/cotacoes/<%= quotation.id %>/peca-chegou" method="POST" style="margin:0"
              onsubmit="return confirm('Confirma chegada de todas as peças?')">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-box-arrow-in-down"></i> Confirmar Chegada
          </button>
        </form>
      <% } else if (showClientActions && !quotation.whatsapp_sent_at) { %>
        <button class="btn btn-success" id="btn-whatsapp">
          <i class="bi bi-whatsapp"></i> Enviar pelo WhatsApp
        </button>
      <% } %>

      <% if (grandTotal > 0) { %>
      <div class="detail-total">
        <div class="detail-total-lbl">Total</div>
        <div class="detail-total-val"><%= fmtBRL(grandTotal) %></div>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Bloco do cliente -->
  <div class="detail-customer-block">
    <div class="avatar lg"><%= initials(quotation.customer_name) %></div>
    <div style="flex:1;min-width:0">
      <div class="detail-customer-name"><%= quotation.customer_name %></div>
      <div style="font-size:12.5px;color:var(--text-3);margin-top:2px">
        Cliente · <%= quotation.make || '' %> <%= quotation.model || '' %>
      </div>
    </div>
    <a href="https://wa.me/<%= quotation.customer_phone.replace(/\D/g,'') %>" target="_blank" rel="noopener" class="detail-whatsapp">
      <i class="bi bi-whatsapp"></i>
      <div style="display:flex;flex-direction:column;align-items:flex-start">
        <span style="font-size:10px;opacity:.8;font-weight:500">WHATSAPP</span>
        <span style="font-weight:700"><%= quotation.customer_phone %></span>
      </div>
    </a>
  </div>

  <!-- Meta grid -->
  <div class="detail-meta-grid">
    <div class="meta-col">
      <div class="meta-col-icon"><i class="bi bi-calendar3"></i></div>
      <div style="min-width:0;flex:1">
        <div class="meta-col-lbl">Criado</div>
        <div class="meta-col-val"><%= fmtDate(quotation.created_at) %></div>
        <div class="meta-col-sub"><%= locals.createdRelative || '' %></div>
      </div>
    </div>
    <div class="meta-col">
      <div class="meta-col-icon blue"><i class="bi bi-person"></i></div>
      <div style="min-width:0;flex:1">
        <div class="meta-col-lbl">Vendedor</div>
        <div class="meta-col-val"><%= quotation.creator_name %></div>
        <div class="meta-col-sub">Setor Vendas</div>
      </div>
    </div>
    <div class="meta-col">
      <div class="meta-col-icon <%= quotation.buyer_name ? 'green' : 'gray' %>"><i class="bi bi-shop"></i></div>
      <div style="min-width:0;flex:1">
        <div class="meta-col-lbl">Compras</div>
        <div class="meta-col-val"><%= quotation.buyer_name || '—' %></div>
        <div class="meta-col-sub"><%= quotation.buyer_name ? 'Setor Compras' : 'Aguardando assumir' %></div>
      </div>
    </div>
    <div class="meta-col">
      <div class="meta-col-icon violet"><i class="bi bi-box-seam"></i></div>
      <div style="min-width:0;flex:1">
        <div class="meta-col-lbl">Peças</div>
        <div class="meta-col-val"><%= items.length %> <%= items.length === 1 ? 'item' : 'itens' %></div>
        <% if (quotation.license_plate) { %>
        <div class="meta-col-sub">Placa <%= quotation.license_plate %></div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- ─── TABS ────────────────────────────────────────────── -->
<div class="tabs">
  <button class="tab <%= defaultTab === 'pecas' ? 'active' : '' %>" onclick="vTab('pecas', this)">
    <i class="bi bi-box-seam"></i> Peças <span class="count">(<%= items.length %>)</span>
  </button>
  <% if (canEdit) { %>
  <button class="tab <%= defaultTab === 'valores' ? 'active' : '' %>" onclick="vTab('valores', this)">
    <i class="bi bi-pencil-square"></i> Preencher Valores
    <% if (quotation.status === 'em_cotacao') { %><span class="alert-dot"></span><% } %>
  </button>
  <% } %>
  <button class="tab" onclick="vTab('cliente', this)">
    <i class="bi bi-person-vcard"></i> Cliente & Veículo
  </button>
  <button class="tab" onclick="vTab('chat', this)">
    <i class="bi bi-chat-square-text"></i> Observações
  </button>
  <button class="tab" onclick="vTab('historico', this)">
    <i class="bi bi-clock-history"></i> Histórico
  </button>
</div>

<!-- ─── LAYOUT GRID ─────────────────────────────────────── -->
<div style="display:grid;grid-template-columns:1fr 320px;gap:16px" id="detail-grid">

<div>
<!-- ABA PEÇAS -->
<div id="vtab-pecas" class="vpanel <%= defaultTab === 'pecas' ? 'active' : '' %>">
  <div class="card">
    <div class="card-head">
      <div class="card-title"><i class="bi bi-box-seam"></i> Peças solicitadas</div>
      <span class="card-meta"><%= items.length %> <%= items.length === 1 ? 'item' : 'itens' %></span>
    </div>
    <div class="card-body tight">
      <table class="items-table">
        <thead>
          <tr>
            <th>Peça</th>
            <th style="text-align:right;width:60px">Qtd</th>
            <th style="text-align:right;width:100px">Vlr Unit.</th>
            <th style="text-align:right;width:110px">Total</th>
            <th style="width:120px">Prazo</th>
            <th style="width:110px">Status</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => {
            const iCfg = {
              aguardando:  { l: 'Aguardando', c: 'pendente'    },
              em_cotacao:  { l: 'Em cotação', c: 'em_cotacao'  },
              cotado:      { l: 'Cotado',     c: 'cotado'      },
              peca_chegou: { l: 'Chegou',     c: 'peca_chegou' }
            }[item.item_status] || { l: item.item_status, c: 'pendente' };
          %>
          <tr>
            <td>
              <div style="font-weight:600;font-size:13px"><%= item.part_name %></div>
              <div style="display:flex;gap:10px;font-size:11.5px;color:var(--text-3);margin-top:2px">
                <% if (item.part_code) { %><span class="mono"><%= item.part_code %></span><% } %>
                <% if (item.supplier_name) { %><span>Forn: <%= item.supplier_name %></span><% } %>
              </div>
            </td>
            <td style="text-align:right" class="num"><%= item.quantity %></td>
            <td style="text-align:right" class="num"><%= fmtBRL(item.unit_price) %></td>
            <td style="text-align:right" class="num" style="font-weight:700">
              <% if (item.total_price) { %><%= fmtBRL(item.total_price) %><% } else { %><span style="color:var(--text-3);font-weight:400">—</span><% } %>
            </td>
            <td style="font-size:12px;color:var(--text-2)">
              <% if (item.delivery_deadline) { %>
                <%= fmtDate(item.delivery_deadline) %>
                <% if (item.delivery_days) { %><div style="font-size:10.5px;color:var(--text-3)" class="num"><%= item.delivery_days %>d</div><% } %>
              <% } else if (item.delivery_days) { %>
                <span class="num"><%= item.delivery_days %> dias</span>
              <% } else { %>—<% } %>
            </td>
            <td><span class="status <%= iCfg.c %>"><span class="dot"></span><%= iCfg.l %></span></td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" style="text-align:right;padding:12px 14px;border-top:2px solid var(--border);font-size:12px;color:var(--text-2);font-weight:600;background:var(--surface-2)">
              Total geral
            </td>
            <td style="text-align:right;padding:12px 14px;border-top:2px solid var(--border);background:var(--surface-2)" class="num">
              <span style="font-size:16px;font-weight:800;color:var(--accent);font-variant-numeric:tabular-nums"><%= fmtBRL(grandTotal) %></span>
            </td>
            <td colspan="2" style="border-top:2px solid var(--border);background:var(--surface-2)"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<!-- ABA VALORES -->
<% if (canEdit) { %>
<div id="vtab-valores" class="vpanel <%= defaultTab === 'valores' ? 'active' : '' %>">
  <form action="/cotacoes/<%= quotation.id %>/responder" method="POST">
    <div class="card" style="margin-bottom:14px">
      <div class="card-head">
        <div class="card-title"><i class="bi bi-pencil-square"></i> Preencher Valores</div>
        <span class="card-meta" style="color:var(--accent);font-weight:600">Modo edição</span>
      </div>
      <div class="card-body" style="display:flex;flex-direction:column;gap:14px">
        <% items.forEach((item, idx) => { %>
        <div style="background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:14px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
            <span class="row-num"><%= idx + 1 %></span>
            <div style="flex:1">
              <div style="font-weight:700;font-size:13px"><%= item.part_name %></div>
              <% if (item.part_code) { %><div class="mono" style="font-size:11px;color:var(--text-3)"><%= item.part_code %></div><% } %>
            </div>
            <span style="font-size:12px;color:var(--text-2)">Qtd: <strong><%= item.quantity %></strong></span>
          </div>
          <input type="hidden" name="item_ids[]" value="<%= item.id %>">
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;margin-bottom:8px">
            <div class="field">
              <label class="label" style="font-size:10.5px">Vlr Unit. (R$)</label>
              <input type="number" name="unit_prices[]" class="input num" step="0.01" min="0" value="<%= item.unit_price || '' %>" data-qty="<%= item.quantity %>" data-idx="<%= idx %>" placeholder="0,00">
            </div>
            <div class="field">
              <label class="label" style="font-size:10.5px">Total (R$)</label>
              <input type="number" name="total_prices[]" class="input num" step="0.01" value="<%= item.total_price || '' %>" data-idx="<%= idx %>" placeholder="0,00">
            </div>
            <div class="field">
              <label class="label" style="font-size:10.5px">M.O. (R$)</label>
              <input type="number" name="labor_costs_compras[]" class="input num" step="0.01" value="<%= item.labor_cost_compras || 0 %>" placeholder="0,00">
            </div>
            <div class="field">
              <label class="label" style="font-size:10.5px">Prazo (dias)</label>
              <input type="number" name="delivery_days[]" class="input num" value="<%= item.delivery_days || '' %>" placeholder="0">
            </div>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr 2fr;gap:8px">
            <div class="field">
              <label class="label" style="font-size:10.5px">Data Entrega</label>
              <input type="date" name="delivery_deadlines[]" class="input" value="<%= item.delivery_deadline ? item.delivery_deadline.substring(0,10) : '' %>">
            </div>
            <div class="field">
              <label class="label" style="font-size:10.5px">Fornecedor</label>
              <input type="text" name="supplier_names[]" class="input" value="<%= item.supplier_name || '' %>" placeholder="Nome do fornecedor">
            </div>
            <div class="field">
              <label class="label" style="font-size:10.5px">Obs. da Peça</label>
              <input type="text" name="item_notes[]" class="input" value="<%= item.notes || '' %>" placeholder="Nota interna">
            </div>
          </div>
        </div>
        <% }) %>

        <div class="field">
          <label class="label">Observações internas de compras</label>
          <textarea name="notes_compras" class="textarea" rows="2" placeholder="Notas internas (visível ao setor de vendas)…"><%= quotation.notes_compras || '' %></textarea>
        </div>
      </div>
    </div>

    <div style="display:flex;align-items:center;justify-content:flex-end;gap:10px">
      <button type="submit" class="btn btn-primary btn-lg">
        <i class="bi bi-check2-circle"></i> Salvar e Notificar Vendedor
      </button>
    </div>
  </form>
</div>
<% } %>

<!-- ABA CLIENTE/VEÍCULO -->
<div id="vtab-cliente" class="vpanel">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
    <div class="card">
      <div class="card-head"><div class="card-title"><i class="bi bi-person"></i> Cliente</div></div>
      <div class="card-body">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
          <div class="avatar lg"><%= initials(quotation.customer_name) %></div>
          <div>
            <div style="font-size:16px;font-weight:700"><%= quotation.customer_name %></div>
            <% if (quotation.customer_since) { %><div style="font-size:12px;color:var(--text-3)">Cliente desde <%= quotation.customer_since %></div><% } %>
          </div>
        </div>
        <a href="https://wa.me/<%= quotation.customer_phone.replace(/\D/g,'') %>" target="_blank" rel="noopener"
           class="btn" style="background:var(--green-soft);color:var(--green);border:1px solid var(--green-border);width:100%">
          <i class="bi bi-whatsapp"></i> <%= quotation.customer_phone %>
        </a>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><div class="card-title"><i class="bi bi-car-front"></i> Veículo</div></div>
      <div class="card-body">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
          <div style="width:56px;height:56px;border-radius:10px;background:var(--surface-2);display:flex;align-items:center;justify-content:center;color:var(--text-2)">
            <i class="bi bi-car-front" style="font-size:24px"></i>
          </div>
          <div>
            <div style="font-size:15px;font-weight:700"><%= quotation.make || '' %> <%= quotation.model || '' %></div>
            <div style="display:flex;gap:8px;margin-top:4px;align-items:center">
              <% if (quotation.license_plate) { %><span class="plate"><%= quotation.license_plate %></span><% } %>
              <% if (quotation.year_model) { %><span style="font-size:12px;color:var(--text-3)" class="num"><%= quotation.year_manuf %>/<%= quotation.year_model %></span><% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ABA CHAT (Observações) -->
<div id="vtab-chat" class="vpanel">
  <div class="card">
    <div class="card-head">
      <div class="card-title"><i class="bi bi-chat-square-text"></i> Observações</div>
      <span class="card-meta">Conversa interna Vendas ↔ Compras</span>
    </div>
    <div class="card-body">
      <% if (!quotation.notes_vendas && !quotation.notes_compras) { %>
        <div class="empty">
          <i class="bi bi-chat-square-dots"></i>
          <div class="ttl">Sem observações</div>
          <div class="sub">Vendas e compras podem trocar notas internas aqui</div>
        </div>
      <% } else { %>
      <div class="chat">
        <% if (quotation.notes_vendas) { %>
        <div class="msg left">
          <div class="avatar md"><%= initials(quotation.creator_name) %></div>
          <div class="msg-body">
            <div class="msg-who">
              <strong style="color:var(--text)"><%= quotation.creator_name %></strong>
              <span class="msg-role vendas">Vendas</span>
            </div>
            <div class="bubble"><%= quotation.notes_vendas %></div>
            <div class="msg-date"><%= fmtDT(quotation.created_at) %></div>
          </div>
        </div>
        <% } %>
        <% if (quotation.notes_compras) { %>
        <div class="msg right">
          <div class="avatar md green"><%= initials(quotation.buyer_name || 'C') %></div>
          <div class="msg-body">
            <div class="msg-who">
              <span class="msg-role compras">Compras</span>
              <strong style="color:var(--text)"><%= quotation.buyer_name || 'Compras' %></strong>
            </div>
            <div class="bubble"><%= quotation.notes_compras %></div>
            <div class="msg-date"><%= fmtDT(quotation.responded_at || quotation.updated_at) %></div>
          </div>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ABA HISTÓRICO -->
<div id="vtab-historico" class="vpanel">
  <div class="card">
    <div class="card-head">
      <div class="card-title"><i class="bi bi-clock-history"></i> Linha do Tempo</div>
      <span class="card-meta"><%= timeline.length %> eventos</span>
    </div>
    <div class="card-body">
      <div class="timeline anim-stagger">
        <% timeline.forEach(ev => { %>
        <div class="tl-item">
          <div class="tl-dot <%= ev.tone %>"></div>
          <div class="tl-label">
            <i class="bi bi-<%= ev.icon %>"></i> <%= ev.label %>
          </div>
          <% if (ev.by) { %><div class="tl-by">por <strong style="color:var(--text-2)"><%= ev.by %></strong></div><% } %>
          <div class="tl-date"><%= fmtDT(ev.date) %></div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

</div>

<!-- ─── SIDE PANEL ──────────────────────────────────────── -->
<div id="side-panel" style="display:flex;flex-direction:column;gap:14px">
  <div class="card">
    <div class="card-head"><div class="card-title"><i class="bi bi-receipt"></i> Resumo</div></div>
    <div class="card-body">
      <div class="summary-row"><span>Subtotal peças</span><span class="val"><%= fmtBRL(partsTotal) %></span></div>
      <% if (laborTotal > 0) { %>
      <div class="summary-row"><span>Mão de obra</span><span class="val"><%= fmtBRL(laborTotal) %></span></div>
      <% } %>
      <div class="summary-total">
        <span class="lbl">Total</span>
        <span class="val"><%= fmtBRL(grandTotal) %></span>
      </div>
    </div>
  </div>
</div>

</div>

<!-- ─── ZONA DE PERIGO ──────────────────────────────────── -->
<% if (canAct) { %>
<div style="border:1px solid var(--red-border);border-radius:var(--r-lg);overflow:hidden;margin-top:22px">
  <div onclick="vDanger(this)" style="padding:13px 20px;background:var(--red-soft);display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none">
    <span style="font-size:12px;font-weight:700;color:var(--red);display:flex;align-items:center;gap:7px">
      <i class="bi bi-exclamation-triangle"></i> Outras Ações
    </span>
    <i class="bi bi-chevron-down" style="color:var(--red);font-size:13px;transition:transform .2s"></i>
  </div>
  <div style="padding:16px 20px;border-top:1px solid var(--red-border);display:none">
    <p style="font-size:12px;color:var(--text-2);margin:0 0 12px">Atenção: esta ação não pode ser desfeita.</p>
    <form action="/cotacoes/<%= quotation.id %>/status" method="POST"
          onsubmit="return confirm('Tem certeza que deseja cancelar esta cotação?')" style="margin:0">
      <input type="hidden" name="status" value="cancelado">
      <button type="submit" class="btn btn-danger-outline">
        <i class="bi bi-x-circle"></i> Cancelar Cotação
      </button>
    </form>
  </div>
</div>
<% } %>

</div>

<style>
.vpanel { display: none; }
.vpanel.active { display: block; }
@media (max-width: 1024px) { #detail-grid { grid-template-columns: 1fr !important; } #side-panel { order: -1; } }
</style>

<script>
function vTab(name, btn) {
  document.querySelectorAll('.vpanel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(b => b.classList.remove('active'));
  document.getElementById('vtab-' + name).classList.add('active');
  btn.classList.add('active');
  const grid = document.getElementById('detail-grid');
  const side = document.getElementById('side-panel');
  // Side panel só mostra nas abas pecas/valores
  if (name === 'pecas' || name === 'valores') {
    grid.style.gridTemplateColumns = '1fr 320px';
    side.style.display = 'flex';
  } else {
    grid.style.gridTemplateColumns = '1fr';
    side.style.display = 'none';
  }
}
function vDanger(hd) {
  const body = hd.nextElementSibling;
  const chev = hd.querySelector('.bi-chevron-down');
  const open = body.style.display === 'block';
  body.style.display = open ? 'none' : 'block';
  chev.style.transform = open ? '' : 'rotate(180deg)';
}

// Auto-calc unit × qty → total
document.querySelectorAll('[name="unit_prices[]"]').forEach(input => {
  input.addEventListener('input', () => {
    const idx = input.dataset.idx, qty = parseFloat(input.dataset.qty) || 1;
    const total = document.querySelector('[name="total_prices[]"][data-idx="' + idx + '"]');
    if (total && !total._touched) total.value = (parseFloat(input.value || 0) * qty).toFixed(2);
  });
});
document.querySelectorAll('[name="total_prices[]"]').forEach(input => {
  input.addEventListener('input', () => { input._touched = parseFloat(input.value) > 0; });
});

// WhatsApp button
const btnWa = document.getElementById('btn-whatsapp');
if (btnWa) {
  btnWa.addEventListener('click', async () => {
    if (!confirm('Enviar resultado para <%= quotation.customer_name %> (<%= quotation.customer_phone %>)?')) return;
    btnWa.disabled = true;
    btnWa.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Enviando...';
    try {
      const r = await fetch('/api/whatsapp/enviar/<%= quotation.id %>', { method: 'POST' });
      const j = await r.json();
      if (j.ok) {
        btnWa.innerHTML = '<i class="bi bi-check2"></i> Enviado!';
        btnWa.style.background = 'var(--green)';
      } else {
        btnWa.disabled = false;
        btnWa.innerHTML = '<i class="bi bi-whatsapp"></i> Enviar pelo WhatsApp';
        alert(j.message || 'Erro ao enviar.');
      }
    } catch {
      btnWa.disabled = false;
      btnWa.innerHTML = '<i class="bi bi-whatsapp"></i> Enviar pelo WhatsApp';
      alert('Falha de conexão.');
    }
  });
}
</script>
