<div class="page">

<%
  function initials(name){ return (name||'?').split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase(); }
  function fmtBRL(v){ if(v==null) return '—'; return 'R$ ' + parseFloat(v).toFixed(2).replace('.',',').replace(/(\d)(?=(\d{3})+,)/g,'$1.'); }
  function fmtDate(d){ return d ? new Date(d).toLocaleDateString('pt-BR') : '—'; }
  const filters = [
    { val: 'todos',       label: 'Todas',       count: locals.statusCount && statusCount.todos      || items.length },
    { val: 'pendente',    label: 'Aguardando',  count: locals.statusCount && statusCount.pendente   || 0 },
    { val: 'em_cotacao',  label: 'Em Cotação',  count: locals.statusCount && statusCount.em_cotacao || 0 },
    { val: 'cotado',      label: 'Cotado',      count: locals.statusCount && statusCount.cotado     || 0 },
    { val: 'peca_chegou', label: 'Peça Chegou', count: locals.statusCount && statusCount.peca_chegou|| 0 },
    { val: 'cancelado',   label: 'Cancelado',   count: locals.statusCount && statusCount.cancelado  || 0 }
  ];
%>

<div class="page-header">
  <div>
    <h1 class="page-title">Cotações</h1>
    <p class="page-subtitle">
      <%= locals.totalCount || items.length %> cotações no total
      <% if (locals.statusCount && statusCount.pendente) { %>· <%= statusCount.pendente %> aguardando<% } %>
    </p>
  </div>
  <% if (currentUser.role === 'vendas' || currentUser.role === 'admin') { %>
  <a href="/cotacoes/nova" class="btn btn-primary">
    <i class="bi bi-plus-lg"></i> Nova Cotação
  </a>
  <% } %>
</div>

<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap">
  <div class="pills">
    <% filters.forEach(f => { %>
    <a href="/cotacoes?status=<%= f.val %>" class="pill <%= currentStatus === f.val ? 'active' : '' %>">
      <%= f.label %><span class="count"><%= f.count %></span>
    </a>
    <% }) %>
  </div>

  <form method="GET" action="/cotacoes" class="input-with-icon" style="flex:1;max-width:320px;margin-left:auto">
    <i class="bi bi-search"></i>
    <input type="text" name="q" class="input" placeholder="Buscar cliente, placa, número…"
           value="<%= typeof q !== 'undefined' ? q : '' %>">
    <% if (currentStatus && currentStatus !== 'todos') { %>
    <input type="hidden" name="status" value="<%= currentStatus %>">
    <% } %>
  </form>

  <div class="view-switch">
    <a href="?<%= currentStatus && currentStatus !== 'todos' ? 'status='+currentStatus+'&' : '' %>view=table"
       class="<%= (locals.view || 'table') === 'table' ? 'active' : '' %>"
       style="text-decoration:none">
      <i class="bi bi-list-ul"></i> Tabela
    </a>
    <a href="?<%= currentStatus && currentStatus !== 'todos' ? 'status='+currentStatus+'&' : '' %>view=kanban"
       class="<%= (locals.view || 'table') === 'kanban' ? 'active' : '' %>"
       style="text-decoration:none">
      <i class="bi bi-kanban"></i> Kanban
    </a>
  </div>
</div>

<% if ((locals.view || 'table') === 'table') { %>
  <% if (items.length === 0) { %>
  <div class="table-wrap"><div class="empty"><i class="bi bi-inbox"></i><div class="ttl">Nenhuma cotação encontrada</div><div class="sub">Ajuste os filtros ou crie uma nova</div></div></div>
  <% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Nº</th>
          <th>Cliente</th>
          <th>Veículo</th>
          <th>Itens</th>
          <th>Status</th>
          <th style="text-align:right">Total</th>
          <% if (currentUser.role !== 'vendas') { %><th>Vendedor</th><% } %>
          <th style="text-align:right">Data</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(q => { %>
        <tr onclick="window.location.href='/cotacoes/<%= q.id %>'">
          <td><a href="/cotacoes/<%= q.id %>" class="qid">#<%= q.quote_number %></a></td>
          <td>
            <div style="display:flex;align-items:center;gap:8px">
              <div class="avatar sm"><%= initials(q.customer_name) %></div>
              <div>
                <div style="font-weight:600;font-size:13px"><%= q.customer_name %></div>
                <div style="font-size:11.5px;color:var(--text-3)"><%= q.customer_phone %></div>
              </div>
            </div>
          </td>
          <td>
            <div style="font-size:12.5px;font-weight:500"><%= q.make || '' %> <%= q.model || '' %></div>
            <% if (q.license_plate) { %><span class="plate"><%= q.license_plate %></span><% } %>
          </td>
          <td>
            <div style="display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text-2)">
              <i class="bi bi-box-seam"></i><span class="num"><%= q.items_count || 0 %></span>
            </div>
          </td>
          <td><%- include('../partials/status-badge', { status: q.status }) %></td>
          <td style="text-align:right" class="num">
            <% if (q.total_price && q.total_price > 0) { %>
              <span style="font-weight:600"><%= fmtBRL(q.total_price) %></span>
            <% } else { %>
              <span style="color:var(--text-3)">—</span>
            <% } %>
          </td>
          <% if (currentUser.role !== 'vendas') { %>
          <td style="font-size:12px;color:var(--text-2)"><%= q.creator_name %></td>
          <% } %>
          <td style="text-align:right;font-size:12px;color:var(--text-3)"><%= fmtDate(q.created_at) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (typeof pages !== 'undefined' && pages > 1) { %>
    <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-top:1px solid var(--border)">
      <span style="color:var(--text-3);font-size:12.5px">Página <%= page %> de <%= pages %></span>
      <div style="display:flex;gap:4px">
        <% for (let p = 1; p <= pages; p++) { %>
        <a href="?status=<%= currentStatus %>&page=<%= p %>"
           class="btn btn-sm <%= p === page ? 'btn-primary' : 'btn-secondary' %>"
           style="padding:4px 10px"><%= p %></a>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
  <% } %>
<% } else { %>
  <!-- Kanban view -->
  <%
    const cols = [
      { key: 'pendente',    label: 'Aguardando',  color: 'var(--amber)' },
      { key: 'em_cotacao',  label: 'Em Cotação',  color: 'var(--blue)' },
      { key: 'cotado',      label: 'Cotado',      color: 'var(--green)' },
      { key: 'peca_chegou', label: 'Peça Chegou', color: 'var(--violet)' }
    ];
  %>
  <div class="kanban">
    <% cols.forEach(c => {
      const colItems = items.filter(q => q.status === c.key);
    %>
    <div class="kan-col">
      <div class="kan-col-hd">
        <span class="dot" style="background:<%= c.color %>"></span>
        <span class="ttl"><%= c.label %></span>
        <span class="cnt"><%= colItems.length %></span>
      </div>
      <% if (colItems.length === 0) { %>
        <div style="font-size:12px;color:var(--text-3);text-align:center;padding:24px 0">Nenhuma</div>
      <% } else { colItems.forEach(q => { %>
      <a href="/cotacoes/<%= q.id %>" class="kan-card" style="text-decoration:none;color:inherit">
        <div class="kan-card-hd">
          <span class="kan-card-num">#<%= q.quote_number %></span>
          <span style="margin-left:auto;font-size:10.5px;color:var(--text-3)"><%= fmtDate(q.created_at) %></span>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
          <div class="avatar sm"><%= initials(q.customer_name) %></div>
          <span class="kan-card-customer"><%= q.customer_name %></span>
        </div>
        <div class="kan-card-veh">
          <i class="bi bi-car-front"></i>
          <span><%= q.make || '' %> <%= q.model || '' %></span>
        </div>
        <div style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-2)">
          <% if (q.license_plate) { %><span class="plate"><%= q.license_plate %></span><% } %>
          <span style="margin-left:auto" class="num"><%= q.items_count || 0 %> item(s)</span>
        </div>
        <div class="kan-card-foot">
          <span><%= q.creator_name %></span>
          <% if (q.total_price && q.total_price > 0) { %>
            <span class="kan-card-total"><%= fmtBRL(q.total_price) %></span>
          <% } %>
        </div>
      </a>
      <% }) } %>
    </div>
    <% }) %>
  </div>
<% } %>

</div>
