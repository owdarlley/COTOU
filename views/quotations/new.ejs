<div class="page page-narrow">

<div class="page-header">
  <div>
    <h1 class="page-title">Nova Cotação</h1>
    <p class="page-subtitle">Preencha em 3 etapas e envie para o setor de compras</p>
  </div>
  <a href="/cotacoes" class="btn btn-secondary">
    <i class="bi bi-arrow-left"></i> Cancelar
  </a>
</div>

<% if (typeof errors !== 'undefined' && errors.length) { %>
<div style="display:flex;align-items:flex-start;gap:10px;padding:12px 14px;background:var(--red-soft);border:1px solid var(--red-border);border-radius:8px;color:var(--red);font-size:13px;margin-bottom:16px">
  <i class="bi bi-exclamation-triangle-fill" style="margin-top:1px"></i>
  <div><% errors.forEach(e => { %><div><%= e %></div><% }) %></div>
</div>
<% } %>

<!-- Tabs -->
<div class="tabs" id="nc-tabs">
  <button type="button" class="tab active" onclick="ncSetTab('cliente', this)" data-tab="cliente">
    <span class="tab-num">1</span><span>Cliente &amp; Veículo</span>
  </button>
  <button type="button" class="tab" onclick="ncSetTab('pecas', this)" data-tab="pecas">
    <span class="tab-num">2</span><span>Peças para Cotar</span>
  </button>
  <button type="button" class="tab" onclick="ncSetTab('observacoes', this)" data-tab="observacoes">
    <span class="tab-num">3</span><span>Observação &amp; Foto</span>
  </button>
</div>

<style>
.tab-num {
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--surface-3); color: var(--text-3);
  font-size: 10px; font-weight: 700;
  display: inline-flex; align-items: center; justify-content: center;
}
.tab.active .tab-num { background: var(--accent); color: #fff; }
.nc-panel { display: none; }
.nc-panel.active { display: block; }
</style>

<form action="/cotacoes" method="POST" id="form-cotacao">
  <input type="hidden" name="photo_base64" id="photo-base64">

  <!-- ABA 1: Cliente & Veículo -->
  <div id="nc-cliente" class="nc-panel active">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
      <div class="card">
        <div class="card-head"><div class="card-title"><i class="bi bi-person"></i> Dados do Cliente</div></div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:12px">
          <div class="field">
            <label class="label">Nome <span class="req">*</span></label>
            <input type="text" name="customer_name" class="input" placeholder="Ex: João da Silva" required
              value="<%= typeof body !== 'undefined' && body.customer_name ? body.customer_name : '' %>">
          </div>
          <div class="field">
            <label class="label">Telefone / WhatsApp <span class="req">*</span></label>
            <div class="input-with-icon">
              <i class="bi bi-whatsapp"></i>
              <input type="text" name="customer_phone" class="input" placeholder="(11) 99999-9999" required
                value="<%= typeof body !== 'undefined' && body.customer_phone ? body.customer_phone : '' %>">
            </div>
            <p class="help">Usaremos para enviar o resultado da cotação</p>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><div class="card-title"><i class="bi bi-car-front"></i> Dados do Veículo</div></div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:12px">
          <div class="field">
            <label class="label">Placa <span class="req">*</span></label>
            <div style="display:flex;gap:6px">
              <input type="text" name="vehicle_plate" id="vehicle_plate" class="input mono"
                style="flex:1;text-transform:uppercase;letter-spacing:.08em;font-weight:600" placeholder="ABC1D23" maxlength="8" required
                value="<%= typeof body !== 'undefined' && body.vehicle_plate ? body.vehicle_plate : '' %>">
              <button type="button" id="btn-buscar-placa" class="btn btn-primary" title="Buscar dados">
                <i class="bi bi-search" id="icon-placa"></i>
              </button>
            </div>
            <p class="help" id="placa-status">Clique na lupa para preenchimento automático</p>
          </div>
          <div class="field">
            <label class="label">Modelo</label>
            <input type="text" name="vehicle_model" id="vehicle_model" class="input" placeholder="Ex: Volkswagen Polo Highline"
              value="<%= typeof body !== 'undefined' && body.vehicle_model ? body.vehicle_model : '' %>">
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <div class="field">
              <label class="label">Ano Fab.</label>
              <input type="number" name="vehicle_year_manuf" id="vehicle_year_manuf" class="input num" placeholder="2022"
                value="<%= typeof body !== 'undefined' && body.vehicle_year_manuf ? body.vehicle_year_manuf : '' %>">
            </div>
            <div class="field">
              <label class="label">Ano Modelo</label>
              <input type="number" name="vehicle_year_model" id="vehicle_year_model" class="input num" placeholder="2023"
                value="<%= typeof body !== 'undefined' && body.vehicle_year_model ? body.vehicle_year_model : '' %>">
            </div>
          </div>
        </div>
        <input type="hidden" name="vehicle_chassis" id="vehicle_chassis">
      </div>
    </div>
  </div>

  <!-- ABA 2: Peças -->
  <div id="nc-pecas" class="nc-panel">
    <div class="card" style="margin-bottom:16px">
      <div class="card-head">
        <div class="card-title"><i class="bi bi-box-seam"></i> Peças para Cotar</div>
        <span class="card-meta" id="items-count">1 item</span>
      </div>
      <div class="card-body tight">
        <table class="items-table" id="items-table">
          <thead>
            <tr>
              <th style="width:36px">#</th>
              <th style="width:130px">Código</th>
              <th>Nome da Peça <span class="req">*</span></th>
              <th style="width:90px;text-align:center">Qtd</th>
              <th style="width:36px"></th>
            </tr>
          </thead>
          <tbody id="items-body">
            <tr class="item-row">
              <td><span class="row-num">1</span></td>
              <td><input type="text" name="part_codes[]" class="input mono part-code" placeholder="Opcional"></td>
              <td style="position:relative">
                <input type="text" name="part_names[]" class="input part-name" placeholder="Ex: Pastilha de freio dianteira" required>
                <div class="autocomplete-list d-none"></div>
              </td>
              <td style="text-align:center">
                <input type="number" name="quantities[]" class="input num" value="1" min="1" style="width:70px;text-align:center">
              </td>
              <td style="text-align:center">
                <button type="button" class="del-btn btn-remove-item" title="Remover"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
          </tbody>
        </table>
        <div style="padding:12px 14px;border-top:1px solid var(--border)">
          <button type="button" class="btn btn-secondary btn-sm" id="btn-add-item">
            <i class="bi bi-plus-lg"></i> Adicionar peça
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ABA 3: Observações + Foto -->
  <div id="nc-observacoes" class="nc-panel">
    <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-bottom:22px">
      <div class="card">
        <div class="card-head">
          <div class="card-title"><i class="bi bi-pencil"></i> Observações</div>
          <span class="card-meta">Visível ao setor de compras</span>
        </div>
        <div class="card-body">
          <textarea name="notes_vendas" class="textarea" rows="8" placeholder="Observações importantes para o setor de compras…"></textarea>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><div class="card-title"><i class="bi bi-image"></i> Foto / Relatório</div></div>
        <div class="card-body">
          <label class="photo-zone" id="photo-zone" style="min-height:200px">
            <i class="bi bi-camera"></i>
            <span class="pz-ttl" id="photo-label">Adicionar foto</span>
            <span class="pz-sub">JPG / PNG até 5MB</span>
            <input type="file" id="photo-input" accept="image/*" style="display:none">
            <img id="photo-preview" src="" alt="Preview" style="display:none;width:100%;height:100%;min-height:200px;object-fit:cover;position:absolute;inset:0;border-radius:10px">
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer actions -->
  <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0">
    <p id="nc-footer-text" style="font-size:12px;color:var(--text-3);margin:0">Passo 1 de 3</p>
    <div style="display:flex;gap:8px">
      <button type="button" id="nc-back" class="btn btn-secondary" style="display:none">
        <i class="bi bi-arrow-left"></i> Voltar
      </button>
      <button type="button" id="nc-next" class="btn btn-primary">
        Próximo <i class="bi bi-arrow-right"></i>
      </button>
      <button type="submit" id="nc-submit" class="btn btn-primary btn-lg" style="display:none">
        Enviar para Compras <i class="bi bi-send"></i>
      </button>
    </div>
  </div>
</form>

</div>

<script>
<%- include('../partials/plate-lookup-script') %>
<%- include('../partials/parts-autocomplete-script') %>

const NC_TABS = ['cliente', 'pecas', 'observacoes'];
let ncIdx = 0;

function ncSetTab(name, btn) {
  ncIdx = NC_TABS.indexOf(name);
  document.querySelectorAll('.nc-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('#nc-tabs .tab').forEach(t => t.classList.remove('active'));
  document.getElementById('nc-' + name).classList.add('active');
  if (btn) btn.classList.add('active');
  else document.querySelector('#nc-tabs .tab[data-tab="' + name + '"]').classList.add('active');
  ncUpdateFooter();
}

function ncUpdateFooter() {
  const isLast = ncIdx === NC_TABS.length - 1;
  document.getElementById('nc-back').style.display = ncIdx > 0 ? 'inline-flex' : 'none';
  document.getElementById('nc-next').style.display = isLast ? 'none' : 'inline-flex';
  document.getElementById('nc-submit').style.display = isLast ? 'inline-flex' : 'none';
  document.getElementById('nc-footer-text').innerHTML = isLast
    ? '<i class="bi bi-info-circle"></i> O setor de compras receberá a notificação em tempo real.'
    : 'Passo ' + (ncIdx + 1) + ' de ' + NC_TABS.length;
}

document.getElementById('nc-next').addEventListener('click', () => ncSetTab(NC_TABS[Math.min(NC_TABS.length - 1, ncIdx + 1)]));
document.getElementById('nc-back').addEventListener('click', () => ncSetTab(NC_TABS[Math.max(0, ncIdx - 1)]));

function updateRowNumbers() {
  document.querySelectorAll('#items-body .item-row').forEach((tr, i) => {
    tr.querySelector('.row-num').textContent = (i + 1);
  });
  const n = document.querySelectorAll('#items-body .item-row').length;
  document.getElementById('items-count').textContent = n + ' ' + (n === 1 ? 'item' : 'itens');
}

document.getElementById('btn-add-item').addEventListener('click', () => {
  const tbody = document.getElementById('items-body');
  const first = tbody.querySelector('.item-row');
  const clone = first.cloneNode(true);
  clone.querySelectorAll('input').forEach(i => {
    if (i.type === 'number') i.value = 1;
    else i.value = '';
  });
  clone.querySelector('.autocomplete-list').classList.add('d-none');
  tbody.appendChild(clone);
  initAutocomplete(clone.querySelector('.part-code'), clone.querySelector('.part-name'));
  updateRowNumbers();
});
document.getElementById('items-body').addEventListener('click', e => {
  if (e.target.closest('.btn-remove-item')) {
    const rows = document.querySelectorAll('.item-row');
    if (rows.length > 1) {
      e.target.closest('.item-row').remove();
      updateRowNumbers();
    }
  }
});
initAutocomplete(document.querySelector('.part-code'), document.querySelector('.part-name'));

// Capitaliza nome
const nameInput = document.querySelector('[name="customer_name"]');
nameInput.setAttribute('autocapitalize', 'words');
nameInput.addEventListener('input', function() {
  const pos = this.selectionStart;
  const titled = this.value.replace(/(?:^|\s)\S/g, c => c.toUpperCase());
  if (titled !== this.value) { this.value = titled; this.setSelectionRange(pos, pos); }
});

// Máscara telefone
const phoneInput = document.querySelector('[name="customer_phone"]');
phoneInput.addEventListener('input', function() {
  const d = this.value.replace(/\D/g, '').slice(0, 11);
  let m = '';
  if (d.length === 0) m = '';
  else if (d.length <= 2) m = '(' + d;
  else if (d.length <= 7) m = '(' + d.slice(0,2) + ') ' + d.slice(2);
  else m = '(' + d.slice(0,2) + ') ' + d.slice(2,7) + '-' + d.slice(7);
  this.value = m;
});

// Foto preview
document.getElementById('photo-input').addEventListener('change', function() {
  const file = this.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    document.getElementById('photo-base64').value = e.target.result;
    const img = document.getElementById('photo-preview');
    img.src = e.target.result;
    img.style.display = 'block';
    document.querySelector('#photo-zone .bi-camera').style.display = 'none';
    document.querySelector('#photo-zone .pz-sub').style.display = 'none';
    document.getElementById('photo-label').textContent = file.name;
    document.getElementById('photo-label').style.color = 'var(--green)';
  };
  reader.readAsDataURL(file);
});
</script>
