<div class="toolbar">
  <div class="toolbar-left">
    <span style="font-size:16px;font-weight:700">Gestão de Usuários</span>
  </div>
  <div class="toolbar-right">
    <a href="/admin/usuarios/novo" class="btn-primary">
      <i class="bi bi-person-plus"></i>Novo Usuário
    </a>
  </div>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr><th>Nome</th><th>E-mail</th><th>Setor</th><th>WhatsApp</th><th>Status</th><th>Ações</th></tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
      <tr>
        <td style="font-weight:600"><%= u.name %></td>
        <td style="color:var(--gray);font-size:13px"><%= u.email %></td>
        <td>
          <span class="role-badge <%= u.role === 'vendas' ? 'role-vendas' : u.role === 'compras' ? 'role-compras' : 'role-admin' %>">
            <%= u.role %>
          </span>
        </td>
        <td style="color:var(--gray);font-size:13px"><%= u.phone_whatsapp || '—' %></td>
        <td>
          <span class="role-badge <%= u.active ? 'role-ativo' : 'role-inativo' %>">
            <%= u.active ? 'Ativo' : 'Inativo' %>
          </span>
        </td>
        <td>
          <div style="display:flex;gap:6px">
            <a href="/admin/usuarios/<%= u.id %>/editar" class="btn-sm-icon blue" title="Editar">
              <i class="bi bi-pencil"></i>
            </a>
            <% if (u.id !== currentUser.id) { %>
            <form action="/admin/usuarios/<%= u.id %>/desativar" method="POST" style="display:inline"
              onsubmit="return confirm('Desativar usuário <%= u.name %>?')">
              <button type="submit" class="btn-sm-icon red" title="Desativar"><i class="bi bi-person-x"></i></button>
            </form>
            <% } %>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
