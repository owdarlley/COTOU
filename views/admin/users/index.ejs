<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:10px">
  <div></div>
  <a href="/admin/usuarios/novo" class="btn-primary">
    <i class="bi bi-person-plus"></i>Novo Usuário
  </a>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr><th>Nome</th><th>E-mail</th><th>Setor</th><th>WhatsApp</th><th>Status</th><th>Ações</th></tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
      <tr>
        <td>
          <div style="display:flex;align-items:center;gap:10px">
            <div class="av" style="width:30px;height:30px;font-size:11px;background:var(--accent);flex-shrink:0">
              <%= u.name.split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase() %>
            </div>
            <strong><%= u.name %></strong>
          </div>
        </td>
        <td style="color:var(--text-muted);font-size:13px"><%= u.email %></td>
        <td>
          <% const roleMap = { admin: { l: 'Admin', c: 'badge-amber' }, vendas: { l: 'Vendas', c: 'badge-blue' }, compras: { l: 'Compras', c: 'badge-green' } }; %>
          <% const rc = roleMap[u.role] || { l: u.role, c: 'badge-gray' }; %>
          <span class="badge <%= rc.c %>"><%= rc.l %></span>
        </td>
        <td style="color:var(--text-muted);font-size:13px"><%= u.phone_whatsapp || '—' %></td>
        <td>
          <span class="badge <%= u.active ? 'badge-green' : 'badge-gray' %>">
            <%= u.active ? 'Ativo' : 'Inativo' %>
          </span>
        </td>
        <td>
          <div style="display:flex;gap:6px">
            <a href="/admin/usuarios/<%= u.id %>/editar" class="btn-icon blue" title="Editar">
              <i class="bi bi-pencil"></i>
            </a>
            <% if (u.id !== currentUser.id) { %>
            <form action="/admin/usuarios/<%= u.id %>/desativar" method="POST" style="display:inline"
              onsubmit="return confirm('Desativar usuário <%= u.name %>?')">
              <button type="submit" class="btn-icon red" title="Desativar"><i class="bi bi-person-x"></i></button>
            </form>
            <% } %>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
